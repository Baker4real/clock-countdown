<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MinminCountdown.WindowVerification</AssemblyName>
    <RootNamespace>MinminCountdown.WindowVerification</RootNamespace>
    <StartupObject>MinminCountdown.WindowVerification.Program</StartupObject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MinminCountdown\MinminCountdown.csproj" />
  </ItemGroup>
</Project>
