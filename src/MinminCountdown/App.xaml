<Application x:Class="MinminCountdown.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:focus="clr-namespace:MinminCountdown"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Startup="OnStartup"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- #197：所有窗口共享 13 / 16 / 20 / 26 / 44 设计坐标字号阶梯。 -->
    <sys:Double x:Key="SecondaryWindowTitleFontSize">26</sys:Double>
    <sys:Double x:Key="SecondaryWindowSectionFontSize">20</sys:Double>
    <sys:Double x:Key="SecondaryWindowBodyFontSize">16</sys:Double>
    <sys:Double x:Key="SecondaryWindowMinorFontSize">13</sys:Double>

    <!-- ═══ 第 1 层：Primitive 原色（*Color；与 ApplicationTheme.Tokens 一一对应，是全部色值的唯一来源） ═══ -->
    <Color x:Key="CanvasColor">#FFFDF3EB</Color>
    <Color x:Key="CanvasDeepColor">#FFFDE8DC</Color>
    <Color x:Key="BackgroundColor">#FFFDF0E4</Color>
    <Color x:Key="CardColor">#FFFEFCFB</Color>
    <Color x:Key="PanelColor">#FFFFFDFC</Color>
    <Color x:Key="CardAltColor">#FFFEF9F5</Color>
    <Color x:Key="StatusBarColor">#FFFDFAF8</Color>
    <Color x:Key="NoteColor">#FFFEF5DC</Color>
    <Color x:Key="NoteWhiteColor">#FFFEFDFD</Color>
    <Color x:Key="NoteLineColor">#FFF6D9B2</Color>
    <Color x:Key="NoteActiveRailColor">#FFCD623E</Color>
    <Color x:Key="NoteCompletedRailColor">#FF8A7069</Color>
    <Color x:Key="NoteTimelineColor">#FFF6DFD3</Color>
    <Color x:Key="InkColor">#FF3B190D</Color>
    <Color x:Key="BodyColor">#FF6B4A3C</Color>
    <Color x:Key="MutedColor">#FF82665F</Color>
    <Color x:Key="ActiveColor">#FFE05A4A</Color>
    <Color x:Key="ActiveHoverColor">#FFB84A36</Color>
    <!-- #151：文本选区高亮独立语义色（0.4 SelectionOpacity 合成在白纸输入面上肉眼可辨），
         不得复用 1px 结构线色 PeachLineColor。 -->
    <Color x:Key="SelectionColor">#FFD4526A</Color>
    <!-- #199：主窗口与悬浮窗统一使用深玫粉主行动；Danger 保留砖红。 -->
    <Color x:Key="MainActionColor">#FFC23E68</Color>
    <Color x:Key="MainActionHoverColor">#FFB0355D</Color>
    <Color x:Key="MainActionPressedColor">#FF9B2D50</Color>
    <Color x:Key="MainActionFocusColor">#FFFFD49A</Color>
    <Color x:Key="MainActionTextColor">#FFFDFC</Color>
    <!-- #151：主窗口次级实心按钮（「保存设置」）珊瑚语义色，比主行动更浅，文字用主文字色。 -->
    <Color x:Key="CoralActionColor">#FFD68481</Color>
    <Color x:Key="PeachLineColor">#FFF6DFD3</Color>
    <Color x:Key="DangerColor">#FFB94D3A</Color>
    <Color x:Key="SuccessColor">#FF266B5E</Color>
    <Color x:Key="TagColor">#FFF7E8</Color>
    <Color x:Key="TagChipTextColor">#FF3B190D</Color>
    <Color x:Key="ExpiredColor">#F9DFDB</Color>
    <Color x:Key="SegmentSelectedColor">#FFFEEFE1</Color>
    <Color x:Key="SegmentSelectedForegroundColor">#FF3B190D</Color>
    <Color x:Key="WorkspacePanelColor">#00FFFDFC</Color>
    <Color x:Key="WorkspacePanelLineColor">#00F6DFD3</Color>
    <Color x:Key="CharacterPanelColor">#FFF7E8</Color>
    <Color x:Key="CharacterLineColor">#EFC9A7</Color>
    <Color x:Key="CharacterMyMelodyDockColor">#FFE3C7</Color>
    <Color x:Key="CharacterCinnamorollDockColor">#FFF0D2</Color>
    <Color x:Key="CharacterKuromiDockColor">#F5DEC5</Color>
    <Color x:Key="IconAccentColor">#F28995</Color>
    <Color x:Key="DecoTextColor">#D9B7B1</Color>
    <Color x:Key="DecoTextSoftColor">#E5AE9C</Color>
    <Color x:Key="PinkBadgeColor">#FD97A1</Color>
    <Color x:Key="PinkBadgeTextColor">#FFFDFC</Color>
    <Color x:Key="PinkTintColor">#FFFEDDDE</Color>
    <Color x:Key="PinkBlockColor">#FEE0E4</Color>
    <Color x:Key="PrimaryCountdownNumberColor">#FFC0102F</Color>
    <Color x:Key="SecondaryBlockColor">#FAF0EA</Color>
    <Color x:Key="PinkTintSoftColor">#FEF0F1</Color>
    <Color x:Key="PeachTintColor">#FEEFE1</Color>
    <Color x:Key="PeachRailColor">#CD623E</Color>
    <Color x:Key="PeachBadgeColor">#FBAE90</Color>
    <Color x:Key="PeachBadgeMutedColor">#F3DED8</Color>
    <Color x:Key="PinkAccentColor">#FFDE5863</Color>
    <Color x:Key="PinkAccentStrongColor">#FFC23E68</Color>
    <Color x:Key="StampPinkColor">#FEEFF1</Color>
    <Color x:Key="StampPinkTextColor">#D41F57</Color>
    <Color x:Key="StampBlueColor">#EEF5FE</Color>
    <Color x:Key="StampBlueTextColor">#FF1D6BB0</Color>
    <Color x:Key="StampGreenColor">#EDF6E8</Color>
    <Color x:Key="StampGreenTextColor">#FF26732D</Color>
    <Color x:Key="WarningAccentColor">#FFAD4A10</Color>
    <Color x:Key="WarningTintColor">#FDEDD8</Color>
    <Color x:Key="ReminderCardColor">#FEF9E8</Color>
    <Color x:Key="ReminderPageColor">#FEFEFE</Color>
    <Color x:Key="SourceNoteIconColor">#FED67F</Color>
    <Color x:Key="FloatingDayPrimaryCountdownAccentColor">#EE2B46</Color>
    <Color x:Key="FloatingDayPlushGlowColor">#B9794E</Color>

    <!-- ═══ 第 2 层：Semantic 语义角色（*Brush；每支画刷只承载一个语义角色，见 DESIGN.md §13） ═══ -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CanvasDeepBrush" Color="{DynamicResource CanvasDeepColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CardAltBrush" Color="{DynamicResource CardAltColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="{DynamicResource StatusBarColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteBrush" Color="{DynamicResource NoteColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteWhiteBrush" Color="{DynamicResource NoteWhiteColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteLineBrush" Color="{DynamicResource NoteLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteActiveRailBrush" Color="{DynamicResource NoteActiveRailColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteCompletedRailBrush" Color="{DynamicResource NoteCompletedRailColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteTimelineBrush" Color="{DynamicResource NoteTimelineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="BodyBrush" Color="{DynamicResource BodyColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ActiveBrush" Color="{DynamicResource ActiveColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ActiveHoverBrush" Color="{DynamicResource ActiveHoverColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionBrush" Color="{DynamicResource MainActionColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionHoverBrush" Color="{DynamicResource MainActionHoverColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionPressedBrush" Color="{DynamicResource MainActionPressedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionFocusBrush" Color="{DynamicResource MainActionFocusColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionTextBrush" Color="{DynamicResource MainActionTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CoralActionBrush" Color="{DynamicResource CoralActionColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PeachLineBrush" Color="{DynamicResource PeachLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="TagBrush" Color="{DynamicResource TagColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="TagChipTextBrush" Color="{DynamicResource TagChipTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ExpiredBrush" Color="{DynamicResource ExpiredColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="{DynamicResource SegmentSelectedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SegmentSelectedForegroundBrush" Color="{DynamicResource SegmentSelectedForegroundColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WorkspacePanelBrush" Color="{DynamicResource WorkspacePanelColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WorkspacePanelLineBrush" Color="{DynamicResource WorkspacePanelLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterPanelBrush" Color="{DynamicResource CharacterPanelColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterLineBrush" Color="{DynamicResource CharacterLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterMyMelodyDockBrush" Color="{DynamicResource CharacterMyMelodyDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterCinnamorollDockBrush" Color="{DynamicResource CharacterCinnamorollDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterKuromiDockBrush" Color="{DynamicResource CharacterKuromiDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource IconAccentColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DecoTextBrush" Color="{DynamicResource DecoTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DecoTextSoftBrush" Color="{DynamicResource DecoTextSoftColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkBadgeBrush" Color="{DynamicResource PinkBadgeColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkBadgeTextBrush" Color="{DynamicResource PinkBadgeTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkTintBrush" Color="{DynamicResource PinkTintColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkBlockBrush" Color="{DynamicResource PinkBlockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PrimaryCountdownNumberBrush" Color="{DynamicResource PrimaryCountdownNumberColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SecondaryBlockBrush" Color="{DynamicResource SecondaryBlockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkTintSoftBrush" Color="{DynamicResource PinkTintSoftColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PeachTintBrush" Color="{DynamicResource PeachTintColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PeachRailBrush" Color="{DynamicResource PeachRailColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PeachBadgeBrush" Color="{DynamicResource PeachBadgeColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PeachBadgeMutedBrush" Color="{DynamicResource PeachBadgeMutedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkAccentBrush" Color="{DynamicResource PinkAccentColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PinkAccentStrongBrush" Color="{DynamicResource PinkAccentStrongColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StampPinkBrush" Color="{DynamicResource StampPinkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StampPinkTextBrush" Color="{DynamicResource StampPinkTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StampBlueBrush" Color="{DynamicResource StampBlueColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StampBlueTextBrush" Color="{DynamicResource StampBlueTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StampGreenBrush" Color="{DynamicResource StampGreenColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="StampGreenTextBrush" Color="{DynamicResource StampGreenTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WarningAccentBrush" Color="{DynamicResource WarningAccentColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{DynamicResource WarningTintColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ReminderCardBrush" Color="{DynamicResource ReminderCardColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ReminderPageBrush" Color="{DynamicResource ReminderPageColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SourceNoteIconBrush" Color="{DynamicResource SourceNoteIconColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayPrimaryCountdownAccentBrush" Color="{DynamicResource FloatingDayPrimaryCountdownAccentColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayPlushGlowBrush" Color="{DynamicResource FloatingDayPlushGlowColor}" po:Freeze="False" />
    <FontFamily x:Key="HandwrittenDecoFontFamily">Segoe Print, Ink Free, Segoe Script, KaiTi, Microsoft YaHei UI, Microsoft YaHei, DengXian, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="UiFontFamily">Microsoft YaHei UI, Microsoft YaHei, DengXian, Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="NumeralFontFamily">Bahnschrift SemiCondensed, Bahnschrift, Microsoft YaHei UI, Microsoft YaHei, DengXian, Segoe UI, Arial, sans-serif</FontFamily>

    <!-- ═══ 第 3 层：Component 组件资源（排版 / 间距 / 焦点 / 圆角，主窗口与悬浮窗共用；口径见 DESIGN.md §13） ═══ -->
    <sys:Double x:Key="TypeDisplayFontSize">44</sys:Double>
    <sys:Double x:Key="TypeH1FontSize">26</sys:Double>
    <sys:Double x:Key="TypeH2FontSize">20</sys:Double>
    <sys:Double x:Key="TypeBodyFontSize">16</sys:Double>
    <sys:Double x:Key="TypeCaptionFontSize">13</sys:Double>
    <sys:Double x:Key="SpacingUnit">8</sys:Double>
    <sys:Double x:Key="SpacingFieldRow">10</sys:Double>
    <sys:Double x:Key="SpacingBlockGap">12</sys:Double>
    <sys:Double x:Key="SpacingCardPadding">14</sys:Double>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>
    <CornerRadius x:Key="RadiusPill">19</CornerRadius>
    <CornerRadius x:Key="RadiusOverlay">12</CornerRadius>
    <CornerRadius x:Key="RadiusControl">9</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusChip">5</CornerRadius>
    <CornerRadius x:Key="RadiusThumb">4</CornerRadius>

    <!-- #194：动效 token。ApplicationTheme.Apply 将这些时长按系统
         ClientAreaAnimation 开关收敛为原值或零；动效只消费这些资源。 -->
    <Duration x:Key="MotionHoverDuration">0:0:0.120</Duration>
    <Duration x:Key="MotionPressDuration">0:0:0.100</Duration>
    <Duration x:Key="MotionPopupEnterDuration">0:0:0.140</Duration>
    <Duration x:Key="MotionPopupExitDuration">0:0:0.090</Duration>
    <Duration x:Key="MotionIndicatorDuration">0:0:0.160</Duration>
    <Duration x:Key="MotionCountdownDuration">0:0:0.090</Duration>
    <PowerEase x:Key="MotionEaseOut" EasingMode="EaseOut" Power="4" />
    <CubicEase x:Key="MotionCubicEaseOut" EasingMode="EaseOut" />

    <!-- 悬浮窗组件画刷：色值全部绑回第 1 层 Primitive，不在组件层自持色值 -->
    <SolidColorBrush x:Key="FloatingDayPanelBrush" Color="{DynamicResource CardColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayBackdropBrush" Color="{DynamicResource BackgroundColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayBorderBrush" Color="{DynamicResource PeachLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayHeaderBrush" Color="{DynamicResource NoteColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayHeaderTextBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayHeaderDangerBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayHeaderHoverBrush" Color="{DynamicResource CardAltColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayHeaderSelectedBrush" Color="{DynamicResource PinkAccentStrongColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayHeaderSelectedTextBrush" Color="{DynamicResource MainActionTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDaySurfaceBrush" Color="{DynamicResource CardColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayNoteCardBrush" Color="{DynamicResource NoteColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayNoteInputBrush" Color="{DynamicResource NoteColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayNoteInputTextBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayErrorBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayTextBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayMutedBrush" Color="{DynamicResource MutedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayMyMelodyDockBrush" Color="{DynamicResource CharacterMyMelodyDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayCinnamorollDockBrush" Color="{DynamicResource CharacterCinnamorollDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingDayKuromiDockBrush" Color="{DynamicResource CharacterKuromiDockColor}" po:Freeze="False" />

    <SolidColorBrush x:Key="FloatingHeaderTextBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingHeaderDangerBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingHeaderHoverBrush" Color="{DynamicResource CardAltColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingHeaderSelectedBrush" Color="{DynamicResource PinkAccentStrongColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingHeaderSelectedTextBrush" Color="{DynamicResource MainActionTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingNoteInputTextBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingErrorBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="FloatingMutedBrush" Color="{DynamicResource MutedColor}" po:Freeze="False" />

    <Style TargetType="{x:Type Window}">
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="1,0,0,6" />
      <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
    </Style>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- #194：悬停颜色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource MainActionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:MotionBehavior.HoverBackgroundResourceKey="MainActionHoverBrush"
                  focus:MotionBehavior.HoverBorderBrushResourceKey="MainActionHoverBrush"
                  focus:MotionBehavior.PressedBackgroundResourceKey="MainActionPressedBrush">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- #194：主行动悬停色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}" />

    <Style x:Key="FloatingAccentButton"
           TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource PinkAccentStrongBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
