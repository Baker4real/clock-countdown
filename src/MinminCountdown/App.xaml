    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="ItemContainerStyle" Value="{DynamicResource {x:Type ComboBoxItem}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                  <ToggleButton Grid.Column="1"
                                ClickMode="Press"
                                Focusable="False"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ArrowSurface" Background="Transparent" CornerRadius="0,9,9,0">
                          <Path Width="10"
                                Height="6"
                                Fill="{DynamicResource BodyBrush}"
                                Data="M 0,0 L 10,0 L 5,6 Z"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource CardBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     focus:PopupMotionBehavior.IsEnabled="True"
                     PopupAnimation="None"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="260"
                        Margin="0,5,0,0"
                        Padding="5"
                        Background="{DynamicResource CanvasBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusOverlay}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DatePickerTextBoxStyle"
           TargetType="{x:Type primitives:DatePickerTextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <!-- #151：日期框文字区与主窗倒计时页白纸输入面同色（由 DatePicker.Background 决定）。 -->
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    </Style>

    <Style TargetType="{x:Type DatePicker}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CalendarStyle" Value="{DynamicResource {x:Type Calendar}}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DatePicker}">
            <Grid x:Name="PART_Root">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
              </Grid.ColumnDefinitions>
              <!-- #153：选中日期文本与列表/组头同一中文日期格式——数字与「月」「日」之间留空格（§3）。
                   绑定固定 OneWay：只读文本框不回写 SelectedDate，行为层负责日期变化后写回同一格式。 -->
              <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                            Grid.Column="0"
                                            Style="{StaticResource DatePickerTextBoxStyle}"
                                            BorderThickness="1,1,0,1"
                                            Padding="{TemplateBinding Padding}"
                                            Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={}{0:yyyy 年 M 月 d 日}}" />
              <Button x:Name="PART_Button"
                      Grid.Column="1"
                      Padding="0"
                      Background="{TemplateBinding Background}"
                      BorderThickness="1"
                      ToolTip="打开日历"
                      AutomationProperties.Name="打开日历">
                <Path Width="10" Height="6" Fill="{DynamicResource BodyBrush}" Data="M 0,0 L 10,0 L 5,6 Z" />
              </Button>
              <Popup x:Name="PART_Popup"
                     Grid.ColumnSpan="2"
                     Placement="Bottom"
                     StaysOpen="False"
                     AllowsTransparency="True"
                     Focusable="False"
                     focus:PopupMotionBehavior.IsEnabled="True"
                     PopupAnimation="None"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Calendar x:Name="PART_Calendar"
                          Margin="0,5,0,0"
                          Style="{TemplateBinding CalendarStyle}"
                          CalendarItemStyle="{StaticResource {x:Type primitives:CalendarItem}}"
                          CalendarDayButtonStyle="{StaticResource {x:Type primitives:CalendarDayButton}}"
                          CalendarButtonStyle="{StaticResource {x:Type primitives:CalendarButton}}"
                          SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_TextBox" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="PART_TextBox" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="PART_TextBox" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="PART_TextBox" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
                <Setter TargetName="PART_Button" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="PART_Button" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CalendarNavigationButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <!-- #152：日历翻月按钮向桌面紧凑下限族（36）靠拢，与筛选芯片同档。 -->
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type Calendar}">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource {x:Type primitives:CalendarDayButton}}" />
      <Setter Property="CalendarButtonStyle" Value="{DynamicResource {x:Type primitives:CalendarButton}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Calendar}">
            <Grid x:Name="PART_Root">
              <Border x:Name="Surface"
                      Padding="6"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusOverlay}">
                <primitives:CalendarItem x:Name="PART_CalendarItem"
                                         Style="{StaticResource {x:Type primitives:CalendarItem}}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarItem}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
            <Grid x:Name="PART_Root" Background="{DynamicResource CanvasBrush}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid x:Name="PART_Header" Margin="2,0,2,7" Background="{DynamicResource CardBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}" />
                <Button x:Name="PART_PreviousButton"
                        Content="‹"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="上一个月"
                        AutomationProperties.Name="上一个月" />
                <Button x:Name="PART_HeaderButton"
                        Grid.Column="1"
                        MinWidth="112"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="切换月份或年份" />
                <Button x:Name="PART_NextButton"
                        Grid.Column="2"
                        Content="›"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="下一个月"
                        AutomationProperties.Name="下一个月" />
              </Grid>
              <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="2" />
              <Grid x:Name="PART_YearView" Grid.Row="1" Margin="2" Visibility="Collapsed" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarDayButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
            <Border x:Name="Surface"
                    Margin="1"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusChip}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsToday" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionBrush}" />
              </Trigger>
              <Trigger Property="IsBlackedOut" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.32" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsInactive" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
            <Border x:Name="Surface"
                    Margin="2"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusChip}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="HasSelectedDays" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsInactive" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Trigger>
        <Trigger Property="HasSelectedDays" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="Auto" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid x:Name="Root">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                Background="Transparent"
                                BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Background="{TemplateBinding Foreground}" Margin="2">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusThumb}" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.72" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ActiveBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                Background="Transparent"
                                BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="10" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" />
              <ScrollBar x:Name="PART_VerticalScrollBar"
                         Grid.Column="1"
                         Orientation="Vertical"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{TemplateBinding VerticalOffset}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
              <ScrollBar x:Name="PART_HorizontalScrollBar"
                         Grid.Row="1"
                         Orientation="Horizontal"
                         Maximum="{TemplateBinding ScrollableWidth}"
                         ViewportSize="{TemplateBinding ViewportWidth}"
                         Value="{TemplateBinding HorizontalOffset}"
                         Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="focus:PopupMotionBehavior.IsToolTipEnabled" Value="True" />
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{DynamicResource RadiusChip}">
              <TextBlock x:Name="Content"
                         Text="{TemplateBinding Content}"
                         Foreground="{TemplateBinding Foreground}"
                         TextWrapping="Wrap" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
