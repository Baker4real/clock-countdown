    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid x:Name="Surface"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box"
                      Width="18"
                      Height="18"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusChip}"
                      VerticalAlignment="Center">
                <Path x:Name="Tick"
                      Width="10"
                      Height="7"
                      Stroke="{DynamicResource MainActionTextBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 1,3.5 L 4,6.5 L 9,1"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- #133 隐式 RadioButton：未显式套样的单选钮不再落到系统默认外观（含系统蓝焦点）。
         视觉语言按 DESIGN.md §4 提醒规则单选组执行，全部引用 §13 token。 -->
    <Style TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  RenderTransformOrigin="0.5,0.5">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <StackPanel Orientation="Horizontal"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                  <Ellipse x:Name="Ring"
                           Fill="Transparent"
                           Stroke="{DynamicResource PeachLineBrush}"
                           StrokeThickness="2" />
                  <Ellipse x:Name="Dot"
                           Width="8"
                           Height="8"
                           Fill="{DynamicResource IconAccentBrush}"
                           Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Margin="8,0,12,0"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource IconAccentBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
