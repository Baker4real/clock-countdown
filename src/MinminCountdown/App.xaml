    <Color x:Key="MutedColor">#87665A</Color>
    <Color x:Key="ActiveColor">#B8533D</Color>
    <Color x:Key="ActiveHoverColor">#B34B36</Color>
    <Color x:Key="MainActionColor">#A24438</Color>
    <Color x:Key="MainActionHoverColor">#8E392F</Color>
    <Color x:Key="MainActionPressedColor">#762D25</Color>
    <Color x:Key="MainActionFocusColor">#FFD49A</Color>
    <Color x:Key="MainActionTextColor">#FFFDFC</Color>
    <Color x:Key="PeachLineColor">#F1D5C5</Color>
    <Color x:Key="DangerColor">#A24438</Color>
    <Color x:Key="SuccessColor">#92522E</Color>
    <Color x:Key="TagColor">#FFF7E8</Color>
    <Color x:Key="TagChipTextColor">#4A2D24</Color>
    <Color x:Key="ExpiredColor">#F9DFDB</Color>
    <Color x:Key="SegmentSelectedColor">#FFF7E8</Color>
    <Color x:Key="SegmentSelectedForegroundColor">#725326</Color>
    <Color x:Key="WorkspacePanelColor">#00FFFDFC</Color>
    <Color x:Key="WorkspacePanelLineColor">#00F1D5C5</Color>
    <Color x:Key="CharacterPanelColor">#FFF7E8</Color>
    <Color x:Key="CharacterLineColor">#EFC9A7</Color>
    <Color x:Key="CharacterMyMelodyDockColor">#FFE3C7</Color>
    <Color x:Key="CharacterCinnamorollDockColor">#FFF0D2</Color>
    <Color x:Key="CharacterKuromiDockColor">#F5DEC5</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteBrush" Color="{DynamicResource NoteColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteLineBrush" Color="{DynamicResource NoteLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteStatusHeaderBrush" Color="{DynamicResource NoteStatusHeaderColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteCompletedHeaderBrush" Color="{DynamicResource NoteCompletedHeaderColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteActiveRailBrush" Color="{DynamicResource NoteActiveRailColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteCompletedRailBrush" Color="{DynamicResource NoteCompletedRailColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="NoteTimelineBrush" Color="{DynamicResource NoteTimelineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource InkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="BodyBrush" Color="{DynamicResource BodyColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ActiveBrush" Color="{DynamicResource ActiveColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ActiveHoverBrush" Color="{DynamicResource ActiveHoverColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionBrush" Color="{DynamicResource MainActionColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionHoverBrush" Color="{DynamicResource MainActionHoverColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionPressedBrush" Color="{DynamicResource MainActionPressedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionFocusBrush" Color="{DynamicResource MainActionFocusColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MainActionTextBrush" Color="{DynamicResource MainActionTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PeachLineBrush" Color="{DynamicResource PeachLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="TagBrush" Color="{DynamicResource TagColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="TagChipTextBrush" Color="{DynamicResource TagChipTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ExpiredBrush" Color="{DynamicResource ExpiredColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="{DynamicResource SegmentSelectedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SegmentSelectedForegroundBrush" Color="{DynamicResource SegmentSelectedForegroundColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WorkspacePanelBrush" Color="{DynamicResource WorkspacePanelColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WorkspacePanelLineBrush" Color="{DynamicResource WorkspacePanelLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterPanelBrush" Color="{DynamicResource CharacterPanelColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterLineBrush" Color="{DynamicResource CharacterLineColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterMyMelodyDockBrush" Color="{DynamicResource CharacterMyMelodyDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterCinnamorollDockBrush" Color="{DynamicResource CharacterCinnamorollDockColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="CharacterKuromiDockBrush" Color="{DynamicResource CharacterKuromiDockColor}" po:Freeze="False" />

    <SolidColorBrush x:Key="FloatingDayPanelBrush" Color="#FFFDFC" />
    <SolidColorBrush x:Key="FloatingDayBackdropBrush" Color="#FFF0E4" />
    <SolidColorBrush x:Key="FloatingDayBorderBrush" Color="#E7C781" />
    <SolidColorBrush x:Key="FloatingDayHeaderBrush" Color="#FFF6D9" />
    <SolidColorBrush x:Key="FloatingDayHeaderTextBrush" Color="#725326" />
    <SolidColorBrush x:Key="FloatingDayHeaderDangerBrush" Color="#A24438" />
    <SolidColorBrush x:Key="FloatingDayHeaderHoverBrush" Color="#FFF0E4" />
    <SolidColorBrush x:Key="FloatingDayHeaderSelectedBrush" Color="#FCE8DE" />
    <SolidColorBrush x:Key="FloatingDayHeaderSelectedTextBrush" Color="#725326" />
    <SolidColorBrush x:Key="FloatingDaySurfaceBrush" Color="#FFFDFC" />
    <SolidColorBrush x:Key="FloatingDayNoteCardBrush" Color="#FFF6D9" />
    <SolidColorBrush x:Key="FloatingDayNoteInputBrush" Color="#FFF6D9" />
    <SolidColorBrush x:Key="FloatingDayNoteInputTextBrush" Color="#725326" />
    <SolidColorBrush x:Key="FloatingDayErrorBrush" Color="#B34B36" />
    <SolidColorBrush x:Key="FloatingDayTextBrush" Color="#4A2D24" />
    <SolidColorBrush x:Key="FloatingDayMutedBrush" Color="#87665A" />
    <SolidColorBrush x:Key="FloatingDayPrimaryCountdownAccentBrush" Color="#A24438" />
    <SolidColorBrush x:Key="FloatingDayPlushGlowBrush" Color="#B9794E" />
    <SolidColorBrush x:Key="FloatingDayMyMelodyDockBrush" Color="#FFE3C7" />
    <SolidColorBrush x:Key="FloatingDayCinnamorollDockBrush" Color="#FFF0D2" />
    <SolidColorBrush x:Key="FloatingDayKuromiDockBrush" Color="#F5DEC5" />

    <SolidColorBrush x:Key="FloatingNightPanelBrush" Color="#3A2B1E" />
    <SolidColorBrush x:Key="FloatingNightBackdropBrush" Color="#241A12" />
    <SolidColorBrush x:Key="FloatingNightBorderBrush" Color="#9B744A" />
    <SolidColorBrush x:Key="FloatingNightHeaderBrush" Color="#4A3524" />
    <SolidColorBrush x:Key="FloatingNightHeaderTextBrush" Color="#FFF4D8" />
    <SolidColorBrush x:Key="FloatingNightHeaderDangerBrush" Color="#FFC0AD" />
    <SolidColorBrush x:Key="FloatingNightHeaderHoverBrush" Color="#5A412B" />
    <SolidColorBrush x:Key="FloatingNightHeaderSelectedBrush" Color="#6E492E" />
    <SolidColorBrush x:Key="FloatingNightHeaderSelectedTextBrush" Color="#FFF8E8" />
    <SolidColorBrush x:Key="FloatingNightSurfaceBrush" Color="#473323" />
    <SolidColorBrush x:Key="FloatingNightNoteCardBrush" Color="#4E3827" />
    <SolidColorBrush x:Key="FloatingNightNoteInputBrush" Color="#F7E1B3" />
    <SolidColorBrush x:Key="FloatingNightNoteInputTextBrush" Color="#4A2D24" />
    <SolidColorBrush x:Key="FloatingNightErrorBrush" Color="#8F342B" />
    <SolidColorBrush x:Key="FloatingNightTextBrush" Color="#FFF4D8" />
    <SolidColorBrush x:Key="FloatingNightMutedBrush" Color="#E9CAA0" />
    <SolidColorBrush x:Key="FloatingNightPrimaryCountdownAccentBrush" Color="#E9B36D" />
    <SolidColorBrush x:Key="FloatingNightPlushGlowBrush" Color="#E9B36D" />
    <SolidColorBrush x:Key="FloatingNightMyMelodyDockBrush" Color="#5A3D2B" />
    <SolidColorBrush x:Key="FloatingNightCinnamorollDockBrush" Color="#55452A" />
    <SolidColorBrush x:Key="FloatingNightKuromiDockBrush" Color="#51362C" />

    <SolidColorBrush x:Key="FloatingHeaderTextBrush" Color="#725326" />
    <SolidColorBrush x:Key="FloatingHeaderDangerBrush" Color="#A24438" />
    <SolidColorBrush x:Key="FloatingHeaderHoverBrush" Color="#FFF0E4" />
    <SolidColorBrush x:Key="FloatingHeaderSelectedBrush" Color="#FCE8DE" />
    <SolidColorBrush x:Key="FloatingHeaderSelectedTextBrush" Color="#725326" />
    <SolidColorBrush x:Key="FloatingNoteInputTextBrush" Color="#725326" />
    <SolidColorBrush x:Key="FloatingErrorBrush" Color="#B34B36" />
    <SolidColorBrush x:Key="FloatingMutedBrush" Color="#87665A" />

    <Style TargetType="{x:Type Window}">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="1,0,0,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
    </Style>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveHoverBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveHoverBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveHoverBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}" />

    <Style x:Key="DangerButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="IconButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
    </Style>

    <Style x:Key="SegmentButton" TargetType="{x:Type ToggleButton}">
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CanvasBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SegmentSelectedForegroundBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FloatingHeaderIconButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource FloatingHeaderTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FloatingHeaderHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FloatingHeaderSegmentButton" TargetType="{x:Type ToggleButton}">
      <Setter Property="Foreground" Value="{DynamicResource FloatingHeaderTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FloatingHeaderHoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource FloatingHeaderSelectedBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource FloatingHeaderSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FloatingHeaderSelectedTextBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterOptionButton"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource SegmentButton}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
    </Style>

    <Style x:Key="TagToggleButton"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource FilterOptionButton}">
      <Setter Property="MinWidth" Value="48" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box"
                      Width="18"
                      Height="18"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      VerticalAlignment="Center">
                <Path x:Name="Tick"
                      Width="10"
                      Height="7"
                      Stroke="White"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M 1,3.5 L 4,6.5 L 9,1"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SegmentSelectedForegroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="ItemContainerStyle" Value="{DynamicResource {x:Type ComboBoxItem}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="9">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                  <ToggleButton Grid.Column="1"
                                ClickMode="Press"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ArrowSurface" Background="Transparent" CornerRadius="0,9,9,0">
                          <Path Width="10"
                                Height="6"
                                Fill="{DynamicResource BodyBrush}"
                                Data="M 0,0 L 10,0 L 5,6 Z"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource CardBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="260"
                        Margin="0,5,0,0"
                        Padding="5"
                        Background="{DynamicResource CanvasBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DatePickerTextBoxStyle"
           TargetType="{x:Type primitives:DatePickerTextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Focusable" Value="False" />
    </Style>

    <Style TargetType="{x:Type DatePicker}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CalendarStyle" Value="{DynamicResource {x:Type Calendar}}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DatePicker}">
            <Grid x:Name="PART_Root">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="38" />
              </Grid.ColumnDefinitions>
              <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                            Grid.Column="0"
                                            Style="{StaticResource DatePickerTextBoxStyle}"
                                            BorderThickness="1,1,0,1"
                                            Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:yyyy年M月d日}}" />
              <Button x:Name="PART_Button"
                      Grid.Column="1"
                      Padding="0"
                      BorderThickness="1"
                      ToolTip="打开日历">
                <Path Width="10" Height="6" Fill="{DynamicResource BodyBrush}" Data="M 0,0 L 10,0 L 5,6 Z" />
              </Button>
              <Popup x:Name="PART_Popup"
                     Grid.ColumnSpan="2"
                     Placement="Bottom"
                     StaysOpen="False"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Calendar x:Name="PART_Calendar"
                          Margin="0,5,0,0"
                          Style="{TemplateBinding CalendarStyle}"
                          CalendarItemStyle="{StaticResource {x:Type primitives:CalendarItem}}"
                          CalendarDayButtonStyle="{StaticResource {x:Type primitives:CalendarDayButton}}"
                          CalendarButtonStyle="{StaticResource {x:Type primitives:CalendarButton}}"
                          SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CalendarNavigationButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type Calendar}">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Calendar}">
            <Grid x:Name="PART_Root">
              <Border x:Name="Surface"
                      Padding="6"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="12">
                <primitives:CalendarItem x:Name="PART_CalendarItem"
                                         Style="{StaticResource {x:Type primitives:CalendarItem}}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarItem}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
            <Grid x:Name="PART_Root" Background="{DynamicResource CanvasBrush}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid x:Name="PART_Header" Margin="2,0,2,7" Background="{DynamicResource CardBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="9" />
                <Button x:Name="PART_PreviousButton"
                        Content="‹"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="上一个月" />
                <Button x:Name="PART_HeaderButton"
                        Grid.Column="1"
                        MinWidth="112"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="切换月份或年份" />
                <Button x:Name="PART_NextButton"
                        Grid.Column="2"
                        Content="›"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="下一个月" />
              </Grid>
              <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="2" />
              <Grid x:Name="PART_YearView" Grid.Row="1" Margin="2" Visibility="Collapsed" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarDayButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
            <Border x:Name="Surface"
                    Margin="1"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsToday" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              </Trigger>
              <Trigger Property="IsBlackedOut" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.32" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
            <Border x:Name="Surface"
                    Margin="2"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="HasSelectedDays" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="Auto" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid x:Name="Root">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Background="{TemplateBinding Foreground}" Margin="2">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.72" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ActiveBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="10" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" />
              <ScrollBar x:Name="PART_VerticalScrollBar"
                         Grid.Column="1"
                         Orientation="Vertical"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{TemplateBinding VerticalOffset}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
              <ScrollBar x:Name="PART_HorizontalScrollBar"
                         Grid.Row="1"
                         Orientation="Horizontal"
                         Maximum="{TemplateBinding ScrollableWidth}"
                         ViewportSize="{TemplateBinding ViewportWidth}"
                         Value="{TemplateBinding HorizontalOffset}"
                         Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="5">
              <TextBlock x:Name="Content"
                         Text="{TemplateBinding Content}"
                         Foreground="{TemplateBinding Foreground}"
                         TextWrapping="Wrap" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
