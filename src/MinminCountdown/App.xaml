    <Style TargetType="{x:Type Window}">
      <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="1,0,0,6" />
      <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
    </Style>

    <!-- 模板不画焦点的键盘停靠点（列表滚动区、状态文字）在各窗口统一挂这层装饰；模板自己画焦点的控件不挂
         （DESIGN.md §4 常驻焦点环）。 -->
    <Style x:Key="MainKeyboardFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <!-- #152：常规键盘焦点为 2px 暖边（§13.3 FocusBorderThickness），不再是 3px 第二套描边。 -->
            <Border Margin="-2"
                    BorderBrush="{DynamicResource ActiveBrush}"
                    BorderThickness="2"
                    CornerRadius="6" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <!-- 模板的 FocusRing 自己画键盘焦点，由 FocusVisualState 的类处理器点亮（DESIGN.md §4 常驻焦点环）。
           样式清掉 FocusVisualStyle，WPF 就不再另叠系统虚线框；基于本样式的按钮沿用，另写模板的焦点样式各自声明。 -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.IsEnabled="True">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- #194：悬停颜色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource MainActionBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:MotionBehavior.HoverBackgroundResourceKey="MainActionHoverBrush"
                  focus:MotionBehavior.HoverBorderBrushResourceKey="MainActionHoverBrush"
                  focus:MotionBehavior.PressedBackgroundResourceKey="MainActionPressedBrush">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- #194：主行动悬停色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
    </Style>

    <Style x:Key="FloatingAccentButton"
           TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource PinkAccentStrongBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:MotionBehavior.HoverBackgroundResourceKey="PinkAccentStrongBrush"
                  focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusPill}" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusPill}"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.94" />
                <!-- #194：悬停边色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style x:Key="IconButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
    </Style>

    <!-- #310：仅保留被衍生筛选/标签样式实际继承的属性设置，移除无使用者的旧模板。 -->
    <Style x:Key="SegmentButton" TargetType="{x:Type ToggleButton}">
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="FloatingHeaderIconButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource FloatingHeaderTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:MotionBehavior.HoverBackgroundResourceKey="FloatingHeaderHoverBrush"
                  focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- #194：悬浮标题悬停色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FloatingHeaderSegmentButton" TargetType="{x:Type ToggleButton}">
      <Setter Property="Foreground" Value="{DynamicResource FloatingHeaderTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <!-- #154：激活胶囊短边一半全圆角——实例命中/渲染高 36 → 圆角 18（不再 RadiusControl 9）。 -->
            <Grid x:Name="InteractionSurface"
                  Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:MotionBehavior.HoverBackgroundResourceKey="FloatingHeaderHoverBrush"
                  focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                  focus:MotionBehavior.CheckedBackgroundResourceKey="PinkAccentStrongBrush"
                  focus:MotionBehavior.CheckedBorderBrushResourceKey="PinkAccentStrongBrush">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="18" />
              <Border x:Name="Surface"
                      Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="16"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- #194：悬浮分段悬停色由 MotionBehavior 以 MotionHoverDuration 插值。 -->
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
              <!-- #152：选中实心粉胶囊（PinkAccentStrongBrush）上的焦点环对实际邻色达非文本门槛：
                   ActiveBrush 对深粉实测 1.37 不达标，改用主按钮焦点色暖金（实测 3.63 ≥3:1）。 -->
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterOptionButton"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource SegmentButton}">
      <!-- #152：筛选芯片高度向桌面紧凑下限族（#143 的 36）靠拢；相邻间距由消费侧统一 8px。 -->
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Grid x:Name="InteractionSurface" Background="Transparent"
                  focus:MotionBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                  focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                  focus:MotionBehavior.CheckedBackgroundResourceKey="PeachTintBrush"
                  focus:MotionBehavior.CheckedBorderBrushResourceKey="PeachRailBrush">
              <Border x:Name="FocusRing" Background="Transparent" BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <Border x:Name="Surface" Margin="{DynamicResource FocusBorderThickness}"
                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path x:Name="SelectedTick" Width="10" Height="8" Margin="0,0,6,0"
                        Stretch="Fill"
                        Stroke="{DynamicResource PeachRailBrush}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="{StaticResource IconCheckmarkGeometry}" Visibility="Hidden" />
                  <ContentPresenter VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SelectedTick" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TagToggleButton"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource FilterOptionButton}">
      <Setter Property="MinWidth" Value="48" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Grid x:Name="Root"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.OpacityTargetNames="Surface,ContentSlot"
                  focus:DisabledStateBehavior.ContrastBorderTargetNames="Surface">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <!-- #303：内容槽固定保留 1 DIP 边框位，Surface 在 1/2 DIP 焦点与错误边之间切换时不挤动布局或内容。 -->
              <Border x:Name="ContentSlot" BorderThickness="1" BorderBrush="Transparent">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
              <Trigger Property="focus:InputErrorState.HasError" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="focus:InputErrorState.HasError" Value="True" />
                  <Condition Property="IsKeyboardFocused" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="focus:ApplicationTheme.IsSystemContrast" Value="True">
          <Setter Property="SelectionOpacity" Value="1" />
          <Setter Property="SelectionTextBrush" Value="{DynamicResource MainActionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
      <Setter Property="Background" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid x:Name="Surface"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5"
                  focus:DisabledStateBehavior.IsEnabled="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box"
                      Width="18"
                      Height="18"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusChip}"
                      VerticalAlignment="Center">
                <Path x:Name="Tick"
                      Width="10"
                      Height="7.5"
                      Stretch="Uniform"
                      Stroke="{DynamicResource MainActionTextBrush}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="{StaticResource IconCheckmarkGeometry}"
                      Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CompletionCheckBox" TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- #133 隐式 RadioButton：未显式套样的单选钮不再落到系统默认外观（含系统蓝焦点）。
         视觉语言按 DESIGN.md §4 提醒规则单选组执行，全部引用 §13 token。 -->
    <Style TargetType="{x:Type RadioButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RadioButton}">
            <Grid x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  RenderTransformOrigin="0.5,0.5"
                  focus:DisabledStateBehavior.IsEnabled="True">
              <Border x:Name="FocusRing"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="{DynamicResource FocusBorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <StackPanel Orientation="Horizontal"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center">
                <Grid Width="18" Height="18">
                  <Ellipse x:Name="Ring"
                           Fill="Transparent"
                           Stroke="{DynamicResource ControlBorderBrush}"
                           StrokeThickness="2" />
                  <Ellipse x:Name="Dot"
                           Width="8"
                           Height="8"
                           Fill="{DynamicResource ActiveBrush}"
                           Visibility="Collapsed" />
                </Grid>
                <ContentPresenter Margin="8,0,12,0"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsKeyboardFocused" Value="True" />
                  <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}"
           BasedOn="{x:Static focus:WpfUiPickerStyles.ComboBoxItem}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SegmentSelectedForegroundBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}"
           BasedOn="{x:Static focus:WpfUiPickerStyles.ComboBox}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ContextMenu" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="ItemContainerStyle" Value="{DynamicResource {x:Type ComboBoxItem}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid x:Name="Root"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.OpacityTargetNames="Surface,ContentSlot"
                  focus:DisabledStateBehavior.ContrastBorderTargetNames="Surface">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <!-- #303：内容槽固定保留 1 DIP 边框位，Surface 切换 1/2 DIP 焦点或错误边时不挤动布局。 -->
              <Border x:Name="ContentSlot" BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                  <!-- WPF-UI's native ComboBox style supplies the base contract
                       and toggle template. Split text/arrow surfaces retain
                       the project's release/press timing and arrow geometry. -->
                  <ToggleButton x:Name="PART_TextToggle"
                                Grid.Column="0"
                                Style="{x:Static focus:WpfUiPickerStyles.ToggleButton}"
                                ClickMode="Release"
                                Focusable="False"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                  <ToggleButton Grid.Column="1"
                                ClickMode="Press"
                                Focusable="False"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ArrowSurface" Margin="0,1,1,1" Background="Transparent" CornerRadius="0,9,9,0">
                          <Path Width="10"
                                Height="6"
                                Fill="{DynamicResource BodyBrush}"
                                Data="{StaticResource IconDropdownTriangleGeometry}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource CardBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                </Grid>
              </Border>
              <focus:MotionPopup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     focus:PopupMotionBehavior.IsEnabled="True"
                     PopupAnimation="None"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="260"
                        Margin="0,5,0,0"
                        Padding="5"
                        Background="{DynamicResource CanvasBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusOverlay}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </focus:MotionPopup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
              <Trigger Property="focus:InputErrorState.HasError" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="focus:InputErrorState.HasError" Value="True" />
                  <Condition Property="IsKeyboardFocusWithin" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DatePickerTextBoxStyle"
           TargetType="{x:Type primitives:DatePickerTextBox}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <!-- #312：文本区位于统一单框 Surface 之内，不再自绘独立边框或底色。 -->
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource ActiveBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type DatePicker}"
           BasedOn="{x:Static focus:WpfUiPickerStyles.DatePicker}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ContextMenu" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CalendarStyle" Value="{DynamicResource {x:Type Calendar}}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DatePicker}">
            <Grid x:Name="PART_Root"
                  focus:DisabledStateBehavior.IsEnabled="True"
                  focus:DisabledStateBehavior.OpacityTargetNames="Surface,ContentSlot"
                  focus:DisabledStateBehavior.ContrastBorderTargetNames="Surface">
              <Border x:Name="Surface"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusControl}" />
              <!-- #303/#312：内容槽固定保留 1 DIP 边框位，Surface 切换 1/2 DIP 焦点或错误边时不挤动布局；
                   单框高度、圆角与 36 DIP 箭头列均与 ComboBox 一致，箭头落在同一外框之内。 -->
              <Border x:Name="ContentSlot" BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <!-- #153：选中日期文本与列表/组头同一中文日期格式——数字与「月」「日」之间留空格（§3）。
                       绑定固定 OneWay：只读文本框不回写 SelectedDate；文字区由模板内置切换面打开日历。 -->
                  <primitives:DatePickerTextBox x:Name="PART_TextBox"
                                                Grid.Column="0"
                                                Style="{StaticResource DatePickerTextBoxStyle}"
                                                Foreground="{TemplateBinding Foreground}"
                                                Padding="{TemplateBinding Padding}"
                                                IsHitTestVisible="False"
                                                Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat={x:Static core:DateDisplay.FullDateBindingFormat}}" />
                  <ToggleButton x:Name="PART_TextToggle"
                                Grid.Column="0"
                                Style="{x:Static focus:WpfUiPickerStyles.ToggleButton}"
                                ClickMode="Release"
                                Focusable="False"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0"
                                AutomationProperties.Name="打开日历"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                  <!-- #152/#312：日期框的 Tab 焦点落在这枚箭头按钮上；整框单层焦点边界由外层 Surface 经
                       IsKeyboardFocusWithin 触发器绘制，按钮不叠 FocusVisualStyle 也不画内框。 -->
                  <ui:Button x:Name="PART_Button"
                             Grid.Column="1"
                             Style="{x:Null}"
                             Focusable="True"
                             IsTabStop="True"
                             FocusVisualStyle="{x:Null}"
                             focus:FocusVisualState.HostDrawsFocus="True"
                             Cursor="Hand"
                             Padding="0"
                             MinWidth="0"
                             MinHeight="0"
                             Background="Transparent"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             ToolTip="打开日历"
                             AutomationProperties.Name="打开日历">
                    <ui:Button.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ArrowSurface"
                                Margin="0,1,1,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,9,9,0">
                          <Path Width="10"
                                Height="6"
                                Fill="{DynamicResource BodyBrush}"
                                Data="{StaticResource IconDropdownTriangleGeometry}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource CardBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ui:Button.Template>
                  </ui:Button>
                </Grid>
              </Border>
              <focus:MotionPopup x:Name="PART_Popup"
                     Placement="Bottom"
                     StaysOpen="False"
                     AllowsTransparency="True"
                     Focusable="False"
                     focus:PopupMotionBehavior.IsEnabled="True"
                     PopupAnimation="None"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}">
                <Calendar x:Name="PART_Calendar"
                          Margin="0,5,0,0"
                          Style="{TemplateBinding CalendarStyle}"
                          CalendarItemStyle="{StaticResource {x:Type primitives:CalendarItem}}"
                          CalendarDayButtonStyle="{StaticResource {x:Type primitives:CalendarDayButton}}"
                          CalendarButtonStyle="{StaticResource {x:Type primitives:CalendarButton}}"
                          SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              </focus:MotionPopup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveHoverBrush}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
              <Trigger Property="focus:InputErrorState.HasError" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="focus:InputErrorState.HasError" Value="True" />
                  <Condition Property="IsKeyboardFocusWithin" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CalendarNavigationButton"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
      <!-- #152：日历翻月按钮向桌面紧凑下限族（36）靠拢，与筛选芯片同档。 -->
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type focus:WpfUiDatePicker}"
           BasedOn="{StaticResource {x:Type DatePicker}}" />

    <Style TargetType="{x:Type Calendar}">
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CalendarItemStyle" Value="{DynamicResource {x:Type primitives:CalendarItem}}" />
      <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource {x:Type primitives:CalendarDayButton}}" />
      <Setter Property="CalendarButtonStyle" Value="{DynamicResource {x:Type primitives:CalendarButton}}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Calendar}">
            <Grid x:Name="PART_Root">
              <Border x:Name="Surface"
                      Padding="6"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{DynamicResource RadiusOverlay}">
                <primitives:CalendarItem x:Name="PART_CalendarItem"
                                         Style="{TemplateBinding CalendarItemStyle}" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarItem}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
            <ControlTemplate.Resources>
              <!-- CalendarItem 只从模板资源取星期标题模板；缺失时 7 个标题退化为空 ContentControl。 -->
              <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
                <TextBlock Margin="0,2,0,4"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="{Binding}" />
              </DataTemplate>
            </ControlTemplate.Resources>
            <Grid x:Name="PART_Root" Background="{DynamicResource CanvasBrush}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid x:Name="PART_Header" Margin="2,0,2,7" Background="{DynamicResource CardBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusControl}" />
                <Button x:Name="PART_PreviousButton"
                        Content="‹"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="上一个月"
                        AutomationProperties.Name="上一个月" />
                <Button x:Name="PART_HeaderButton"
                        Grid.Column="1"
                        MinWidth="112"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="切换月份或年份" />
                <Button x:Name="PART_NextButton"
                        Grid.Column="2"
                        Content="›"
                        Style="{StaticResource CalendarNavigationButton}"
                        ToolTip="下一个月"
                        AutomationProperties.Name="下一个月" />
              </Grid>
              <!-- CalendarItem 只给格子写 Grid.Row/Column，行列定义由模板提供：月视图 1 行星期标题
                   + 6 行日期 × 7 列，年/十年视图 3 × 4。缺定义时全部格子叠进同一格。 -->
              <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="2" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              </Grid>
              <Grid x:Name="PART_YearView" Grid.Row="1" Margin="2" HorizontalAlignment="Center" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarDayButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="2" />
      <!-- 统一日期格尺寸：Auto 列不随一位/两位数字宽窄不齐，命中区高于紧凑下限 24。 -->
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
            <Border x:Name="Surface"
                    Margin="1"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusChip}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="IsToday" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionBrush}" />
              </Trigger>
              <Trigger Property="IsBlackedOut" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.32" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="{DynamicResource FocusBorderThickness}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsInactive" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type primitives:CalendarButton}">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
            <Border x:Name="Surface"
                    Margin="2"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusChip}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
              </Trigger>
              <Trigger Property="HasSelectedDays" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsInactive" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Trigger>
        <Trigger Property="HasSelectedDays" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="Auto" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <!-- #306：共享滚动条保留 10 DIP 命中轨（与浮窗 #157 同样以模板轨隔离系统滚动条列宽），
                 静止时 ThumbSurface 以 ScaleTransform 缩为 4 DIP，悬停命中轨或拖动时平滑展开至 10 DIP。 -->
            <Grid x:Name="SharedScrollBarHitRail"
                  Width="10"
                  HorizontalAlignment="Right"
                  Background="Transparent"
                  focus:ScrollBarMotionBehavior.IsEnabled="True">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="PART_DecreaseRepeatButton"
                                Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Background="{TemplateBinding Foreground}"
                         Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                          <Border x:Name="ThumbSurface"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{DynamicResource RadiusThumb}"
                                  RenderTransformOrigin="1,0.5">
                            <Border.RenderTransform>
                              <ScaleTransform ScaleX="0.4" ScaleY="1" />
                            </Border.RenderTransform>
                          </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ActiveBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="PART_IncreaseRepeatButton"
                                Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                IsTabStop="False"
                                Background="Transparent"
                                BorderThickness="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="SharedScrollBarHitRail" Property="Width" Value="Auto" />
                <Setter TargetName="SharedScrollBarHitRail" Property="Height" Value="10" />
                <Setter TargetName="SharedScrollBarHitRail" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="SharedScrollBarHitRail" Property="VerticalAlignment" Value="Bottom" />
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="PART_DecreaseRepeatButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                <Setter TargetName="PART_IncreaseRepeatButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="10" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" />
              <ScrollBar x:Name="PART_VerticalScrollBar"
                         Grid.Column="1"
                         Orientation="Vertical"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{TemplateBinding VerticalOffset}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
              <ScrollBar x:Name="PART_HorizontalScrollBar"
                         Grid.Row="1"
                         Orientation="Horizontal"
                         Maximum="{TemplateBinding ScrollableWidth}"
                         ViewportSize="{TemplateBinding ViewportWidth}"
                         Value="{TemplateBinding HorizontalOffset}"
                         Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- #244：ToolTip 的进入与退出只由 PopupMotionBehavior 负责。WPF 自带的 ToolTip 弹层淡入
         会叠在它上面，连开的 ToolTip 无法即时出现，关闭动画时也到不了终态，所以关掉。 -->
    <PopupAnimation x:Key="{x:Static SystemParameters.ToolTipPopupAnimationKey}">None</PopupAnimation>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="focus:PopupMotionBehavior.IsToolTipEnabled" Value="True" />
      <Setter Property="Background" Value="{DynamicResource InkBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="MaxWidth" Value="360" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{DynamicResource RadiusChip}">
              <TextBlock x:Name="Content"
                         Text="{TemplateBinding Content}"
                         Foreground="{TemplateBinding Foreground}"
                         TextWrapping="Wrap" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
