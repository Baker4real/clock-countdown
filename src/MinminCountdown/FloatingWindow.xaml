<Window x:Class="MinminCountdown.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        Title="敏敏子悬浮窗"
        Width="520"
        Height="390"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Grid x:Name="TaskWrap"
        Margin="0"
        Background="Transparent"
        PreviewMouseDown="OnFloatingDragSurfaceMouseLeftButtonDown">
    <Canvas x:Name="FloatingDayRasterScene"
            Panel.ZIndex="0"
            IsHitTestVisible="False">
      <Image x:Name="DayOuterShellImage"
             Width="520"
             Height="390"
             IsHitTestVisible="False"
             Stretch="Fill" />
      <Image x:Name="DayHeaderImage"
             Canvas.Left="51"
             Canvas.Top="72"
             Width="422"
             Height="63"
             IsHitTestVisible="False"
             Stretch="Fill" />
    </Canvas>
    <Border x:Name="FloatingThemeBackdrop"
            Panel.ZIndex="1"
            Margin="27,54,32,26"
            Background="{DynamicResource FloatingDayBackdropBrush}"
            BorderBrush="{DynamicResource FloatingDayBorderBrush}"
            BorderThickness="2"
            CornerRadius="28"
            IsHitTestVisible="False" />
    <Border x:Name="TaskCard"
            Panel.ZIndex="1"
            Margin="45,72,47,43"
            Padding="5,0,0,0"
            Background="{DynamicResource FloatingDayPanelBrush}"
            BorderBrush="{DynamicResource FloatingDayBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
      <!-- #154：去掉原字面色大面积投影（DropShadowEffect #6F4A3C/Blur24/Opacity0.16）。
           深度由 1px 暖边 + raster 表达（§5 结构基因 4：不堆阴影），主行动按钮现役无投影，
           不引入「主按钮级极轻投影」的第三种深度语言。 -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="FloatingHeaderSurface"
                Grid.Row="0"
                Height="62"
                Padding="12,8,16.5,8"
                Background="{DynamicResource FloatingDayHeaderBrush}"
                BorderBrush="{DynamicResource FloatingDayBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="FloatingDragHandle"
                    Grid.Column="0"
                    Background="Transparent"
                    Cursor="SizeAll">
              <TextBlock x:Name="FloatingTitle"
                         Text="倒计时"
                         Margin="16,0,0,0"
                         MinWidth="92"
                         MinHeight="34"
                         FontSize="{DynamicResource TypeH2FontSize}"
                         FontWeight="SemiBold"
                         LineHeight="32"
                         LineStackingStrategy="BlockLineHeight"
                         Foreground="{DynamicResource FloatingHeaderTextBrush}"
                         VerticalAlignment="Center" />
            </Border>
            <ToggleButton x:Name="FloatingCountdownsButton"
                          Grid.Column="1"
                          Width="85"
                          Height="36"
                          Content="倒计时"
                          Style="{DynamicResource FloatingHeaderSegmentButton}" />
            <ToggleButton x:Name="FloatingNotesButton"
                          Grid.Column="2"
                          Width="72"
                          Height="36"
                          Margin="8,0,0,0"
                          Content="便签"
                          Style="{DynamicResource FloatingHeaderSegmentButton}" />
            <Button x:Name="MinimizeToTrayButton"
                    Grid.Column="3"
                    Width="36"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="缩小到系统托盘"
                    Style="{DynamicResource FloatingHeaderIconButton}">
              <Viewbox Width="12" Height="12" Margin="0,1,0,0">
                <Path Data="M 2,10 L 12,10"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Viewbox>
            </Button>
            <Button x:Name="OpenManagerButton"
                    Grid.Column="4"
                    Width="36"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="打开管理窗口"
                    Style="{DynamicResource FloatingHeaderIconButton}">
              <Viewbox Width="16" Height="16" Margin="0,1,0,0">
                <Path Data="M 2,8 L 9,2 L 16,8 L 16,16 L 2,16 Z"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
            </Button>
            <Button x:Name="CloseFloatingButton"
                    Grid.Column="5"
                    Width="36"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource FloatingHeaderDangerBrush}"
                    ToolTip="退出应用"
                    Style="{DynamicResource FloatingHeaderIconButton}">
              <Viewbox Width="12" Height="12" Margin="0,2,0,0">
                <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Viewbox>
            </Button>
          </Grid>
        </Border>

        <Grid x:Name="FloatingNoteSearchSlot"
              Grid.Row="1"
              Margin="8,8,76,0"
              Visibility="Collapsed">
          <Grid x:Name="FloatingNoteSearchInputRow"
                Visibility="Collapsed">
            <TextBox x:Name="FloatingNoteSearch"
                     MaxLength="140"
                     MinHeight="36"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource CanvasBrush}"
                     BorderBrush="{DynamicResource PeachLineBrush}"
                     Foreground="{DynamicResource FloatingNoteInputTextBrush}" />
            <TextBlock x:Name="FloatingNoteSearchPlaceholder"
                       Margin="8,6,8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource FloatingMutedBrush}"
                       FontSize="{DynamicResource TypeCaptionFontSize}"
                       Text="搜索便签"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
          </Grid>
          <Grid x:Name="FloatingNoteSearchHint"
                Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="FloatingNoteSearchHintTerm"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    MinHeight="36"
                    Height="36"
                    Padding="8,0"
                    FontSize="{DynamicResource TypeCaptionFontSize}"
                    Style="{DynamicResource SecondaryButton}">
              <Button.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </Button.ContentTemplate>
            </Button>
            <Button x:Name="FloatingNoteSearchHintClear"
                    Grid.Column="1"
                    Width="36"
                    MinWidth="36"
                    MinHeight="36"
                    Height="36"
                    Padding="0"
                    Margin="8,0,0,0"
                    Content="✕"
                    FontSize="{DynamicResource TypeCaptionFontSize}"
                    Style="{DynamicResource SecondaryButton}" />
          </Grid>
        </Grid>

        <ScrollViewer x:Name="FloatingBodyScroller"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}">
              <Setter Property="Width" Value="10" />
              <Setter Property="Height" Value="Auto" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource PeachLineBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="FloatingScrollBarHitRail"
                          Width="10"
                          HorizontalAlignment="Right"
                          Background="Transparent">
                      <Track x:Name="PART_Track"
                             Orientation="{TemplateBinding Orientation}"
                             IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsTabStop="False">
                            <RepeatButton.Template>
                              <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                              </ControlTemplate>
                            </RepeatButton.Template>
                          </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                          <local:FloatingScrollBarThumb x:Name="FloatingScrollBarThumb"
                                                        Width="10"
                                                        Background="{DynamicResource FloatingMutedBrush}"
                                                        Focusable="False">
                            <local:FloatingScrollBarThumb.Template>
                              <ControlTemplate TargetType="{x:Type local:FloatingScrollBarThumb}">
                                <Grid Background="Transparent">
                                  <Border x:Name="FloatingScrollBarThumbVisual"
                                          Width="{TemplateBinding VisualWidth}"
                                          HorizontalAlignment="Right"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{DynamicResource PeachLineBrush}"
                                          BorderThickness="0.5"
                                          CornerRadius="3"
                                          Opacity="{TemplateBinding ThumbOpacity}" />
                                </Grid>
                              </ControlTemplate>
                            </local:FloatingScrollBarThumb.Template>
                          </local:FloatingScrollBarThumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsTabStop="False">
                            <RepeatButton.Template>
                              <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                              </ControlTemplate>
                            </RepeatButton.Template>
                          </RepeatButton>
                        </Track.IncreaseRepeatButton>
                      </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="10" />
                        <Setter TargetName="FloatingScrollBarHitRail" Property="Width" Value="Auto" />
                        <Setter TargetName="FloatingScrollBarHitRail" Property="Height" Value="10" />
                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel>
            <StackPanel x:Name="FloatingRows"
                        Margin="8,13,11,0" />

            <TextBlock x:Name="FloatingIncome"
                       Margin="12,10,0,29"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource FloatingMutedBrush}" />
          </StackPanel>
        </ScrollViewer>

        <!-- #117 收尾：快速新增展开时表单+命令行可能超过外壳剩余空间；命令区整体收进限高
             滚动容器（滚动热区最右 x=396 内），收起态内容高度低于限高，布局与基线不变。 -->
        <ScrollViewer x:Name="FloatingNotesCommandScroller"
                      Grid.Row="3"
                      Margin="0,0,76,0"
                      MaxHeight="170"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}">
              <Setter Property="Width" Value="10" />
              <Setter Property="Height" Value="Auto" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource PeachLineBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="FloatingScrollBarHitRail"
                          Width="10"
                          HorizontalAlignment="Right"
                          Background="Transparent">
                      <Track x:Name="PART_Track"
                             Orientation="{TemplateBinding Orientation}"
                             IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsTabStop="False">
                            <RepeatButton.Template>
                              <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                              </ControlTemplate>
                            </RepeatButton.Template>
                          </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                          <local:FloatingScrollBarThumb x:Name="FloatingScrollBarThumb"
                                                        Width="10"
                                                        Background="{DynamicResource FloatingMutedBrush}"
                                                        Focusable="False">
                            <local:FloatingScrollBarThumb.Template>
                              <ControlTemplate TargetType="{x:Type local:FloatingScrollBarThumb}">
                                <Grid Background="Transparent">
                                  <Border x:Name="FloatingScrollBarThumbVisual"
                                          Width="{TemplateBinding VisualWidth}"
                                          HorizontalAlignment="Right"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{DynamicResource PeachLineBrush}"
                                          BorderThickness="0.5"
                                          CornerRadius="3"
                                          Opacity="{TemplateBinding ThumbOpacity}" />
                                </Grid>
                              </ControlTemplate>
                            </local:FloatingScrollBarThumb.Template>
                          </local:FloatingScrollBarThumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsTabStop="False">
                            <RepeatButton.Template>
                              <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                              </ControlTemplate>
                            </RepeatButton.Template>
                          </RepeatButton>
                        </Track.IncreaseRepeatButton>
                      </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="10" />
                        <Setter TargetName="FloatingScrollBarHitRail" Property="Width" Value="Auto" />
                        <Setter TargetName="FloatingScrollBarHitRail" Property="Height" Value="Auto" />
                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel x:Name="FloatingNotesCommandArea"
                      Visibility="Collapsed">
          <Border x:Name="FloatingNoteEntry"
                  Width="319"
                  HorizontalAlignment="Left"
                  Margin="9,0,0,0"
                  Padding="10"
                  Background="{DynamicResource FloatingDayNoteInputBrush}"
                  BorderBrush="{DynamicResource FloatingDayBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Visibility="Collapsed">
            <StackPanel>
              <Border Width="18"
                      Height="3"
                      Margin="2,-4,0,7"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource FloatingHeaderDangerBrush}"
                      IsHitTestVisible="False" />
              <Grid>
                <TextBox x:Name="FloatingNoteText"
                         MaxHeight="88"
                         MaxLength="140"
                         Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <!-- #149：快速新增正文占位文与管理窗口便签内容占位一致（DESIGN §4 占位文表）。 -->
                <TextBlock x:Name="FloatingNoteTextPlaceholder"
                           Margin="8,6,8,0"
                           VerticalAlignment="Top"
                           FontSize="{DynamicResource TypeCaptionFontSize}"
                           Foreground="{DynamicResource FloatingMutedBrush}"
                           IsHitTestVisible="False"
                           Text="写下要记住的事情吧…">
                  <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=FloatingNoteText}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <TextBlock x:Name="FloatingNoteTextError"
                         Margin="2,4,2,0"
                         Foreground="{DynamicResource FloatingErrorBrush}"
                         TextWrapping="Wrap"
                         Visibility="Collapsed" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="FloatingNoteDate" />
                <Button x:Name="FloatingManageReminderRules"
                        Grid.Column="1"
                        Width="116"
                        Margin="8,0,0,0"
                        Content="提醒规则"
                        Style="{DynamicResource SecondaryButton}" />
              </Grid>
              <TextBlock x:Name="FloatingNoteDateError"
                         Margin="2,4,2,0"
                         Foreground="{DynamicResource FloatingErrorBrush}"
                         TextWrapping="Wrap"
                         Visibility="Collapsed" />
              <TextBlock x:Name="FloatingReminderRulesSummary"
                         Margin="2,5,2,0"
                         Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                         Text="不提醒"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="FloatingReminderMessage"
                         Margin="2,4,2,0"
                         Foreground="{DynamicResource FloatingErrorBrush}"
                         TextWrapping="Wrap"
                         Visibility="Collapsed" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:TagSelector x:Name="FloatingTags" HorizontalAlignment="Stretch" />
                <Button x:Name="FloatingAddNote"
                        Grid.Column="1"
                        Width="68"
                        Margin="8,0,0,0"
                        Content="添加"
                        Style="{DynamicResource PrimaryButton}" />
              </Grid>
              <TextBlock x:Name="FloatingNoteMessage"
                         Margin="2,6,2,0"
                         Foreground="{DynamicResource FloatingErrorBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid x:Name="FloatingNotesCommandBar"
                Margin="9,4,0,6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
              <Button x:Name="FloatingAddNoteToggle"
                      MinHeight="38"
                      Padding="14,0"
                      Style="{DynamicResource FloatingAccentButton}"
                      ToolTip="展开或收起快速新增便签表单" />
              <Button x:Name="FloatingSearchNotes"
                      Width="38"
                      MinWidth="38"
                      MinHeight="38"
                      Margin="8,0,0,0"
                      Padding="0"
                      FocusVisualStyle="{x:Null}"
                      Style="{DynamicResource SecondaryButton}"
                      ToolTip="搜索便签">
                <Grid Width="16" Height="16">
                  <Ellipse Width="9"
                           Height="9"
                           Margin="1,1,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Fill="Transparent"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                           StrokeThickness="1.6" />
                  <Line X1="8.2"
                        Y1="8.2"
                        X2="14.5"
                        Y2="14.5"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1.6"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Grid>
              </Button>
              <Button x:Name="FloatingOpenSettings"
                      MinHeight="38"
                      Margin="8,0,0,0"
                      Padding="12,0"
                      Style="{DynamicResource SecondaryButton}"
                      ToolTip="打开管理窗口">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="15"
                        Height="15"
                        VerticalAlignment="Center">
                    <Path Data="M 6.55,0.9 L 8.45,0.9 L 8.9,2.5 C 9.32,2.64 9.7,2.84 10.05,3.1 L 11.68,2.55 L 12.63,4.2 L 11.4,5.3 C 11.43,5.53 11.45,5.76 11.45,6 C 11.45,6.24 11.43,6.47 11.4,6.7 L 12.63,7.8 L 11.68,9.45 L 10.05,8.9 C 9.7,9.16 9.32,9.36 8.9,9.5 L 8.45,11.1 L 6.55,11.1 L 6.1,9.5 C 5.68,9.36 5.3,9.16 4.95,8.9 L 3.32,9.45 L 2.37,7.8 L 3.6,6.7 C 3.57,6.47 3.55,6.24 3.55,6 C 3.55,5.76 3.57,5.53 3.6,5.3 L 2.37,4.2 L 3.32,2.55 L 4.95,3.1 C 5.3,2.84 5.68,2.64 6.1,2.5 Z"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.1"
                          StrokeLineJoin="Round" />
                    <Ellipse Width="3.4"
                             Height="3.4"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="Transparent"
                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                             StrokeThickness="1.1" />
                  </Grid>
                  <TextBlock Text="设置"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Grid Grid.Row="1"
                  Margin="0,2,0,0">
              <!-- #156：悬浮窗手写体装饰退出控件朗读（SilentTextBlock 无自动化 peer，§4/#156 合同）。 -->
              <local:SilentTextBlock x:Name="FloatingNotesDecoTextLeft"
                         Text="Have a nice day!"
                         Margin="2,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         FontFamily="{DynamicResource HandwrittenDecoFontFamily}"
                         FontSize="{DynamicResource TypeCaptionFontSize}"
                         Foreground="{DynamicResource DecoTextSoftBrush}"
                         IsHitTestVisible="False"
                         Focusable="False" />
              <local:SilentTextBlock x:Name="FloatingNotesDecoText"
                         Text="Live a sweeter day ♡"
                         Margin="0,0,2,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         FontFamily="{DynamicResource HandwrittenDecoFontFamily}"
                         FontSize="{DynamicResource TypeCaptionFontSize}"
                         Foreground="{DynamicResource DecoTextSoftBrush}"
                         IsHitTestVisible="False"
                         Focusable="False" />
            </Grid>
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Canvas x:Name="FloatingPlushScene"
            Panel.ZIndex="3"
            IsHitTestVisible="False">
      <Image x:Name="DayMascotsImage"
             Width="520"
             Height="390"
             IsHitTestVisible="False"
             Stretch="Fill"
             Visibility="Collapsed" />
    </Canvas>
  </Grid>
</Window>
