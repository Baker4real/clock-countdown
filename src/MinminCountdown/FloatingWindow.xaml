<Window x:Class="MinminCountdown.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        Title="敏敏子悬浮窗"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Grid x:Name="TaskWrap" Margin="0">
    <Border x:Name="FloatingThemeBackdrop"
            Margin="18,58,18,22"
            Background="{DynamicResource FloatingDayBackdropBrush}"
            BorderBrush="{DynamicResource FloatingDayBorderBrush}"
            BorderThickness="2"
            CornerRadius="28"
            IsHitTestVisible="False" />
    <Border x:Name="TaskCard"
            Margin="32,112,32,42"
            Padding="18,20"
            Background="{DynamicResource FloatingDayPanelBrush}"
            BorderBrush="{DynamicResource FloatingDayBorderBrush}"
            BorderThickness="2"
            CornerRadius="24">
      <Border.Effect>
        <DropShadowEffect Color="#6F4A3C" BlurRadius="24" ShadowDepth="4" Opacity="0.16" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="FloatingHeaderSurface"
                Grid.Row="0"
                Padding="12,8"
                Background="{DynamicResource FloatingDayHeaderBrush}"
                BorderBrush="{DynamicResource FloatingDayBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FloatingTitle"
                       Text="倒计时"
                       Margin="72,0,0,0"
                       MinWidth="76"
                       MinHeight="28"
                       FontSize="18"
                       FontWeight="Bold"
                       LineHeight="26"
                       LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource FloatingHeaderTextBrush}"
                       VerticalAlignment="Center" />
            <ToggleButton x:Name="FloatingCountdownsButton"
                          Grid.Column="1"
                          Width="88"
                          Content="倒计时"
                          Style="{DynamicResource FloatingHeaderSegmentButton}" />
            <ToggleButton x:Name="FloatingNotesButton"
                          Grid.Column="2"
                          Width="72"
                          Margin="5,0,0,0"
                          Content="便签"
                          Style="{DynamicResource FloatingHeaderSegmentButton}" />
            <Button x:Name="OpenManagerButton"
                    Grid.Column="3"
                    Width="38"
                    Margin="5,0,0,0"
                    Content="⌂"
                    ToolTip="打开管理窗口"
                    Style="{DynamicResource FloatingHeaderIconButton}" />
            <Button x:Name="CloseFloatingButton"
                    Grid.Column="4"
                    Width="38"
                    Margin="5,0,0,0"
                    Content="×"
                    Foreground="{DynamicResource FloatingHeaderDangerBrush}"
                    ToolTip="退出应用"
                    Style="{DynamicResource FloatingHeaderIconButton}" />
          </Grid>
        </Border>

        <ScrollViewer x:Name="FloatingRowsScroller"
                      Grid.Row="1"
                      Margin="0,12,90,0"
                      MaxHeight="410"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="FloatingRows" />
        </ScrollViewer>

        <Border x:Name="FloatingNoteEntry"
                Grid.Row="2"
                Margin="0,10,90,0"
                Padding="12"
                Background="{DynamicResource FloatingDayNoteInputBrush}"
                BorderBrush="{DynamicResource FloatingDayBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
          <StackPanel>
            <TextBox x:Name="FloatingNoteText" MaxLength="140" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <DatePicker x:Name="FloatingNoteDate" />
              <ComboBox x:Name="FloatingReminder"
                        Grid.Column="1"
                        Width="116"
                        Margin="8,0,0,0" />
            </Grid>
            <Grid x:Name="FloatingReminderSchedule"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FloatingReminderLabel"
                         Grid.ColumnSpan="4"
                         Margin="0,0,0,5"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                         Text="首次提醒（北京时间）" />
              <DatePicker x:Name="FloatingReminderDate"
                          Grid.Row="1"
                          ToolTip="首次提醒日期（北京时间）" />
              <ComboBox x:Name="FloatingReminderHour"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="64"
                        Margin="8,0,0,0"
                        ToolTip="首次提醒小时" />
              <TextBlock x:Name="FloatingReminderSeparator"
                         Grid.Row="1"
                         Grid.Column="2"
                         Margin="4,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                         Text=":" />
              <ComboBox x:Name="FloatingReminderMinute"
                         Grid.Row="1"
                         Grid.Column="3"
                         Width="64"
                         ToolTip="首次提醒分钟" />
              <StackPanel x:Name="FloatingReminderIntervalPanel"
                          Grid.Row="2"
                          Grid.ColumnSpan="4"
                          Margin="0,8,0,0"
                          Orientation="Horizontal"
                          Visibility="Collapsed">
                <TextBlock x:Name="FloatingReminderIntervalLabel"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                           Text="重复间隔" />
                <ComboBox x:Name="FloatingReminderInterval" Width="116" />
                <TextBox x:Name="FloatingCustomReminderMinutes"
                         Width="70"
                         Margin="8,0,0,0"
                         MaxLength="4"
                         Visibility="Collapsed" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <local:TagSelector x:Name="FloatingTags" HorizontalAlignment="Stretch" />
              <Button x:Name="FloatingAddNote"
                      Grid.Column="1"
                      Width="68"
                      Margin="8,0,0,0"
                      Content="添加"
                      Style="{DynamicResource PrimaryButton}" />
            </Grid>
            <TextBlock x:Name="FloatingNoteMessage"
                       Margin="2,6,2,0"
                       Foreground="{DynamicResource FloatingErrorBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="FloatingIncome"
                   Grid.Row="3"
                   Margin="0,10,90,0"
                   Foreground="{DynamicResource FloatingMutedBrush}" />
      </Grid>
    </Border>

    <Canvas x:Name="FloatingPlushScene"
            Panel.ZIndex="3"
            IsHitTestVisible="False">
      <Border x:Name="MyMelodyPlushAnchor"
              Canvas.Left="0"
              Canvas.Top="32"
              Width="128"
              Height="128"
              Background="Transparent"
              BorderThickness="0"
              IsHitTestVisible="False">
        <Image x:Name="PlushTopLeft"
               Width="128"
               Height="128"
               IsHitTestVisible="False"
               Stretch="Uniform" />
      </Border>
      <Border x:Name="CinnamorollPlushAnchor"
              Canvas.Right="0"
              Canvas.Top="32"
              Width="128"
              Height="128"
              Background="Transparent"
              BorderThickness="0"
              IsHitTestVisible="False">
        <Image x:Name="PlushTopRight"
               Width="128"
               Height="128"
               IsHitTestVisible="False"
               Stretch="Uniform" />
      </Border>
      <Border x:Name="KuromiPlushAnchor"
              Canvas.Right="0"
              Canvas.Bottom="0"
              Width="132"
              Height="132"
              Background="Transparent"
              BorderThickness="0"
              IsHitTestVisible="False">
        <Image x:Name="PlushBottomRight"
               Width="132"
               Height="132"
               IsHitTestVisible="False"
               Stretch="Uniform" />
      </Border>
    </Canvas>
  </Grid>
</Window>
