<Window x:Class="MinminCountdown.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        Title="敏敏子悬浮窗"
        Width="520"
        Height="390"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <SolidColorBrush x:Key="FloatingNightPlushGlowBrush" Color="#756A62" />
  </Window.Resources>
  <Grid x:Name="TaskWrap"
        Margin="0"
        Background="Transparent"
        PreviewMouseDown="OnFloatingDragSurfaceMouseLeftButtonDown">
    <Canvas x:Name="FloatingDayRasterScene"
            Panel.ZIndex="0"
            IsHitTestVisible="False">
      <Image x:Name="DayOuterShellImage"
             Width="520"
             Height="390"
             IsHitTestVisible="False"
             Stretch="Fill" />
      <Image x:Name="DayHeaderImage"
             Canvas.Left="51"
             Canvas.Top="72"
             Width="422"
             Height="63"
             IsHitTestVisible="False"
             Stretch="Fill" />
    </Canvas>
    <Border x:Name="FloatingThemeBackdrop"
            Panel.ZIndex="1"
            Margin="27,54,32,26"
            Background="{DynamicResource FloatingDayBackdropBrush}"
            BorderBrush="{DynamicResource FloatingDayBorderBrush}"
            BorderThickness="2"
            CornerRadius="28"
            IsHitTestVisible="False" />
    <Border x:Name="TaskCard"
            Panel.ZIndex="1"
            Margin="45,72,47,43"
            Padding="5,0,0,0"
            Background="{DynamicResource FloatingDayPanelBrush}"
            BorderBrush="{DynamicResource FloatingDayBorderBrush}"
            BorderThickness="1"
            CornerRadius="24">
      <Border.Effect>
        <DropShadowEffect Color="#6F4A3C" BlurRadius="24" ShadowDepth="4" Opacity="0.16" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="FloatingHeaderSurface"
                Grid.Row="0"
                Height="62"
                Padding="12,8,16.5,8"
                Background="{DynamicResource FloatingDayHeaderBrush}"
                BorderBrush="{DynamicResource FloatingDayBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="FloatingDragHandle"
                    Grid.Column="0"
                    Background="Transparent"
                    Cursor="SizeAll">
              <TextBlock x:Name="FloatingTitle"
                         Text="倒计时"
                         Margin="16,0,0,0"
                         MinWidth="92"
                         MinHeight="34"
                         FontSize="22"
                         FontWeight="SemiBold"
                         LineHeight="32"
                         LineStackingStrategy="BlockLineHeight"
                         Foreground="{DynamicResource FloatingHeaderTextBrush}"
                         VerticalAlignment="Center" />
            </Border>
            <ToggleButton x:Name="FloatingCountdownsButton"
                          Grid.Column="1"
                          Width="85"
                          Content="倒计时"
                          Style="{DynamicResource FloatingHeaderSegmentButton}" />
            <ToggleButton x:Name="FloatingNotesButton"
                          Grid.Column="2"
                          Width="72"
                          Margin="8,0,0,0"
                          Content="便签"
                          Style="{DynamicResource FloatingHeaderSegmentButton}" />
            <Button x:Name="MinimizeToTrayButton"
                    Grid.Column="3"
                    Width="36"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="缩小到系统托盘"
                    Style="{DynamicResource FloatingHeaderIconButton}">
              <Viewbox Width="12" Height="12" Margin="0,1,0,0">
                <Path Data="M 2,10 L 12,10"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Viewbox>
            </Button>
            <Button x:Name="OpenManagerButton"
                    Grid.Column="4"
                    Width="36"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="打开管理窗口"
                    Style="{DynamicResource FloatingHeaderIconButton}">
              <Viewbox Width="16" Height="16" Margin="0,1,0,0">
                <Path Data="M 2,8 L 9,2 L 16,8 L 16,16 L 2,16 Z"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>
            </Button>
            <Button x:Name="CloseFloatingButton"
                    Grid.Column="5"
                    Width="36"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource FloatingHeaderDangerBrush}"
                    ToolTip="退出应用"
                    Style="{DynamicResource FloatingHeaderIconButton}">
              <Viewbox Width="12" Height="12" Margin="0,2,0,0">
                <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Viewbox>
            </Button>
          </Grid>
        </Border>

        <Grid x:Name="FloatingNoteSearchSlot"
              Grid.Row="1"
              Margin="8,8,11,0"
              Visibility="Collapsed">
          <Grid x:Name="FloatingNoteSearchInputRow"
                Visibility="Collapsed">
            <TextBox x:Name="FloatingNoteSearch"
                     MaxLength="140"
                     MinHeight="28"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource CanvasBrush}"
                     BorderBrush="{DynamicResource PeachLineBrush}"
                     Foreground="{DynamicResource FloatingNoteInputTextBrush}" />
            <TextBlock x:Name="FloatingNoteSearchPlaceholder"
                       Margin="8,6,8,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource FloatingMutedBrush}"
                       FontSize="12"
                       Text="搜索便签"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
          </Grid>
          <Grid x:Name="FloatingNoteSearchHint"
                Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="FloatingNoteSearchHintTerm"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    FontSize="12"
                    Style="{DynamicResource SecondaryButton}">
              <Button.ContentTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </Button.ContentTemplate>
            </Button>
            <Button x:Name="FloatingNoteSearchHintClear"
                    Grid.Column="1"
                    Width="28"
                    MinWidth="28"
                    Margin="8,0,0,0"
                    Content="✕"
                    FontSize="12"
                    Style="{DynamicResource SecondaryButton}" />
          </Grid>
        </Grid>

        <ScrollViewer x:Name="FloatingBodyScroller"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}">
              <Setter Property="Width" Value="10" />
              <Setter Property="Height" Value="Auto" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="{DynamicResource PeachLineBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="FloatingScrollBarHitRail"
                          Width="10"
                          HorizontalAlignment="Right"
                          Background="Transparent">
                      <Track x:Name="PART_Track"
                             Orientation="{TemplateBinding Orientation}"
                             IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsTabStop="False">
                            <RepeatButton.Template>
                              <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                              </ControlTemplate>
                            </RepeatButton.Template>
                          </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                          <local:FloatingScrollBarThumb x:Name="FloatingScrollBarThumb"
                                                        Width="10"
                                                        Background="{DynamicResource FloatingMutedBrush}"
                                                        Focusable="False">
                            <local:FloatingScrollBarThumb.Template>
                              <ControlTemplate TargetType="{x:Type local:FloatingScrollBarThumb}">
                                <Grid Background="Transparent">
                                  <Border x:Name="FloatingScrollBarThumbVisual"
                                          Width="{TemplateBinding VisualWidth}"
                                          HorizontalAlignment="Right"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{DynamicResource PeachLineBrush}"
                                          BorderThickness="0.5"
                                          CornerRadius="3"
                                          Opacity="{TemplateBinding ThumbOpacity}" />
                                </Grid>
                              </ControlTemplate>
                            </local:FloatingScrollBarThumb.Template>
                          </local:FloatingScrollBarThumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="False"
                                        IsTabStop="False">
                            <RepeatButton.Template>
                              <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent" />
                              </ControlTemplate>
                            </RepeatButton.Template>
                          </RepeatButton>
                        </Track.IncreaseRepeatButton>
                      </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="10" />
                        <Setter TargetName="FloatingScrollBarHitRail" Property="Width" Value="Auto" />
                        <Setter TargetName="FloatingScrollBarHitRail" Property="Height" Value="10" />
                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel>
            <StackPanel x:Name="FloatingRows"
                        Margin="8,13,11,0" />

            <Border x:Name="FloatingNoteEntry"
                    Margin="8,10,1,0"
                    Padding="10"
                    Background="{DynamicResource FloatingDayNoteInputBrush}"
                    BorderBrush="{DynamicResource FloatingDayBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
              <StackPanel>
                <Border Width="18"
                        Height="3"
                        Margin="2,-4,0,7"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource FloatingHeaderDangerBrush}"
                        IsHitTestVisible="False" />
                <TextBox x:Name="FloatingNoteText"
                         MaxHeight="88"
                         MaxLength="140"
                         Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="FloatingNoteTextError"
                           Margin="2,4,2,0"
                           Foreground="{DynamicResource FloatingErrorBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <DatePicker x:Name="FloatingNoteDate" />
                  <Button x:Name="FloatingManageReminderRules"
                          Grid.Column="1"
                          Width="116"
                          Margin="8,0,0,0"
                          Content="提醒规则"
                          Style="{DynamicResource SecondaryButton}" />
                </Grid>
                <TextBlock x:Name="FloatingNoteDateError"
                           Margin="2,4,2,0"
                           Foreground="{DynamicResource FloatingErrorBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="FloatingReminderRulesSummary"
                           Margin="2,5,2,0"
                           Foreground="{DynamicResource FloatingNoteInputTextBrush}"
                           Text="不提醒"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FloatingReminderMessage"
                           Margin="2,4,2,0"
                           Foreground="{DynamicResource FloatingErrorBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <local:TagSelector x:Name="FloatingTags" HorizontalAlignment="Stretch" />
                  <Button x:Name="FloatingAddNote"
                          Grid.Column="1"
                          Width="68"
                          Margin="8,0,0,0"
                          Content="添加"
                          Style="{DynamicResource PrimaryButton}" />
                  <Button x:Name="FloatingSearchNotes"
                          Grid.Column="2"
                          Width="36"
                          MinWidth="36"
                          Margin="8,0,0,0"
                          Style="{DynamicResource SecondaryButton}"
                          Visibility="Collapsed">
                    <Viewbox Width="14" Height="14">
                      <Path Data="M 6,6 m -3.6,0 a 3.6,3.6 0 1 1 7.2,0 a 3.6,3.6 0 1 1 -7.2,0 M 8.7,8.7 L 12.2,12.2"
                            Fill="Transparent"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="1.6"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                    </Viewbox>
                  </Button>
                </Grid>
                <TextBlock x:Name="FloatingNoteMessage"
                           Margin="2,6,2,0"
                           Foreground="{DynamicResource FloatingErrorBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="FloatingIncome"
                       Margin="12,10,0,29"
                       Foreground="{DynamicResource FloatingMutedBrush}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Canvas x:Name="FloatingPlushScene"
            Panel.ZIndex="3"
            IsHitTestVisible="False">
      <Image x:Name="DayMascotsImage"
             Width="520"
             Height="390"
             IsHitTestVisible="False"
             Stretch="Fill"
             Visibility="Collapsed" />
      <Border x:Name="MyMelodyPlushAnchor"
              Canvas.Left="5.75"
              Canvas.Top="2.87"
              Width="139.70"
              Height="99.12"
              Background="Transparent"
              BorderThickness="0"
              ClipToBounds="True"
              IsHitTestVisible="False">
        <Image x:Name="PlushTopLeft"
               Width="139.70"
               Height="99.12"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               IsHitTestVisible="False"
               Stretch="Fill" />
      </Border>
      <Border x:Name="CinnamorollPlushAnchor"
              Canvas.Left="369.17"
              Canvas.Top="13.29"
              Width="140.41"
              Height="80.08"
              Background="Transparent"
              BorderThickness="0"
              ClipToBounds="True"
              IsHitTestVisible="False">
        <Image x:Name="PlushTopRight"
               Width="140.41"
               Height="80.08"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               IsHitTestVisible="False"
               Stretch="Fill" />
      </Border>
      <Border x:Name="KuromiPlushAnchor"
              Canvas.Left="405.44"
              Canvas.Top="205.41"
              Width="114.56"
              Height="112.40"
              Background="Transparent"
              BorderThickness="0"
              ClipToBounds="True"
              IsHitTestVisible="False">
        <Image x:Name="PlushBottomRight"
               Width="114.56"
               Height="112.40"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               IsHitTestVisible="False"
               Stretch="Fill" />
      </Border>
    </Canvas>
  </Grid>
</Window>
