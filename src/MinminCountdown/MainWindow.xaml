<Window x:Class="MinminCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        xmlns:focus="clr-namespace:MinminCountdown"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="敏敏子倒计时"
        Width="864"
        Height="1000"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Topmost="{Binding IsChecked, ElementName=TopmostCheck, Mode=OneWay}"
        Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <Style x:Key="MainKeyboardFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <!-- #152：常规键盘焦点为 2px 暖边（§13.3 FocusBorderThickness），不再是 3px 第二套描边。 -->
            <Border Margin="-2"
                    BorderBrush="{DynamicResource ActiveBrush}"
                    BorderThickness="2"
                    CornerRadius="6" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <!-- #211：标题拖动区覆盖整个身份区（行高 130）的空白；身份区内置顶/最小化/关闭
         控件以 IsHitTestVisibleInChrome 保持可点击。 -->
    <shell:WindowChrome CaptionHeight="130"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource BackgroundBrush}">
    <!-- #211：864×1000 是首选尺寸而非最小尺寸。窗口随所在显示器工作区收缩时，
         #221 倒计时列表先适配剩余高度，低于实际内容最小高度时使用窗口级纵向滚动；
         便签保留首选内容高度，宽度不足时两页都横向滚动兜底，控件与字号不缩放。
         The named grid is retained as the reference surface and popup clipping root;
         it no longer performs a non-integer Viewbox transform. -->
    <ScrollViewer x:Name="MainWindowScrollHost"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Focusable="False">
      <Grid x:Name="MainScaleViewport"
            Width="864"
            Height="1000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ClipToBounds="True">
      <Canvas x:Name="MainLayoutSurface"
              Width="864"
              Height="1000"
              ClipToBounds="True">
        <Canvas x:Name="MainReferenceDecorationLayer"
                Width="864"
                Height="1000"
                Panel.ZIndex="1"
                IsHitTestVisible="False">
          <Image x:Name="CountdownReferenceDecoration"
                 Width="864"
                 Height="1000"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
          <Image x:Name="NotesReferenceDecoration"
                 Width="864"
                 Height="1000"
                 Stretch="Fill"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
        </Canvas>

        <Grid x:Name="MainContentProjection"
              Width="864"
              Height="1000"
              Panel.ZIndex="2"
              TextElement.FontSize="{DynamicResource TypeCaptionFontSize}"
              Background="Transparent">
          <Grid.Resources>
            <Style x:Key="MainFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource FieldLabel}">
              <Setter Property="Margin" Value="0" />
              <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
            </Style>
            <Style x:Key="MainSecondaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButton}">
              <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
              <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
              <Setter Property="Padding" Value="13,0" />
              <!-- 管理窗口等比收缩：共享 Button 的 38/40 最小命中随之降到 28/30（仍 ≥ 24 紧凑下限）。 -->
              <Setter Property="MinHeight" Value="28" />
              <Setter Property="MinWidth" Value="30" />
            </Style>
            <Style x:Key="MainNoteSegmentButton" TargetType="{x:Type ToggleButton}">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                          focus:MotionBehavior.CheckedBackgroundResourceKey="PeachTintBrush">
                      <!-- #154：激活胶囊短边一半全圆角——环包按钮高 36 → 18；Surface 高 36-2×2=32 → 16。 -->
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="18" />
                      <Border x:Name="Surface"
                              Margin="2"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="Transparent"
                              BorderThickness="1"
                              CornerRadius="16"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <!-- 选中底色与前景同步更新；悬停过渡仍由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：页签悬停边色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteDateDisclosureButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="4,3" />
              <Setter Property="MinHeight" Value="31" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="5">
                        <Border x:Name="Surface"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                RenderTransformOrigin="0.5,0.5">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                        </Border>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：日期披露悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <!-- #152：按压与键盘焦点同语言（环 ActiveBrush），替代原 Opacity 0.9；补齐禁用 0.45。 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainPrimaryButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
              <Setter Property="Background" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="13,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #217：主按钮使用调深暖金 MainActionFocusBrush；常驻 2px 透明环变色，
                       悬停/按压/焦点都不再改 BorderThickness，内容不因状态位移。 -->
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="MainActionHoverBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="MainActionHoverBrush"
                          focus:MotionBehavior.PressedBackgroundResourceKey="MainActionPressedBrush">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="12" />
                      <Border x:Name="Surface"
                              Margin="2"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="10"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：主行动悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <!-- #194：按压底色与缩放由 MotionBehavior 插值。 -->
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <!-- #217：「保存设置」使用 CardAlt + ControlBorder，保留既有尺寸和主次角色。 -->
            <Style x:Key="MainSecondarySolidButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Padding" Value="13,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- 常驻 2px 透明焦点环与表面保留 1px 间隙，不因焦点挤压内容。 -->
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="12" />
                      <Border x:Name="Surface"
                              Margin="3"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="9"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：次级行动悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainSegmentButton" TargetType="{x:Type ToggleButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Height" Value="44" />
              <Setter Property="Padding" Value="13,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #152：页签改常驻 2px 透明环 + 1px 间隙；选中粉底（PinkTintBrush）上
                       ActiveBrush 环不再直接贴粉底（实测 2.90 <3:1），环对容器/间隙浅色 ≥3:1。 -->
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                          focus:MotionBehavior.CheckedBackgroundResourceKey="PinkTintBrush"
                          focus:MotionBehavior.CheckedBorderBrushResourceKey="PinkTintBrush">
                      <!-- #154：激活胶囊短边一半全圆角——环包按钮高 44 → 22；Surface 高 44-2×3=38 → 19。 -->
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="22" />
                      <Border x:Name="Surface"
                              Margin="3"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="19"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：分段悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNotesSegmentButton"
                   TargetType="{x:Type ToggleButton}"
                   BasedOn="{StaticResource MainSegmentButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #152：未选中「便签」页签悬停改「边换 ActiveBrush」，不复用选中实心底 PeachTintBrush；
                       按压/焦点与键盘焦点同语言（环 ActiveBrush），补齐禁用 0.45。 -->
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                          focus:MotionBehavior.CheckedBackgroundResourceKey="PinkTintBrush"
                          focus:MotionBehavior.CheckedBorderBrushResourceKey="PinkTintBrush">
                      <!-- #154：同 MainSegmentButton——短边一半全圆角（环 22 / Surface 高 38 → 19）。 -->
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="22" />
                      <Border x:Name="Surface"
                              Margin="3"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="19"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：便签页签悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainIconButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource IconButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="MainTopmostCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Surface" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Box"
                              Width="19"
                              Height="19"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="6"
                              VerticalAlignment="Center">
                        <Path x:Name="Tick"
                              Width="11"
                              Height="8"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 0.75,3.75 L 4.5,7.5 L 10.5,0.75"
                              Visibility="Collapsed" />
                      </Border>
                      <ContentPresenter Grid.Column="1"
                                        Margin="7,0,0,0"
                                        VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <!-- #217：未选中使用 Active；选中用对外侧浅底达标的暖金。常驻边框只换色。 -->
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsChecked" Value="True" />
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="Surface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteCompletionCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <!-- #152/#208：真实 DIP 命中槽位 28（≥ 桌面紧凑下限 24），
                         可见勾选框 18 居中；边框常驻 2px、焦点只换色。 -->
                    <Grid x:Name="Surface" Width="28" Height="28" Background="Transparent">
                      <Border x:Name="Box"
                              Width="18"
                              Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource ControlBorderBrush}"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="4">
                        <Path x:Name="Tick"
                              Width="10"
                              Height="7"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 0.75,3.75 L 3.75,6.75 L 9.75,0.75"
                              Visibility="Collapsed" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource SuccessBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="Surface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Padding" Value="13,0" />
            </Style>
            <Style TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Padding" Value="13,0" />
            </Style>
            <Style TargetType="{x:Type local:WpfUiDatePicker}"
                   BasedOn="{StaticResource {x:Type DatePicker}}">
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            </Style>
            <Style x:Key="MainCompactFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource MainFieldLabel}">
              <!-- #197：字段标签统一 13px SemiBold。 -->
              <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
            </Style>
            <Style x:Key="MainCompactTextInput"
                   TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Height" Value="41" />
              <Setter Property="Padding" Value="12,0" />
              <!-- #151：输入面使用白纸面板色，与页面画布分开（§4 输入框底 PanelBrush）。 -->
              <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            </Style>
            <Style x:Key="MainCompactSelectionInput"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Height" Value="41" />
              <Setter Property="Padding" Value="12,0" />
              <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            </Style>
            <Style x:Key="MainCompactDateInput"
                   TargetType="{x:Type local:WpfUiDatePicker}"
                   BasedOn="{StaticResource {x:Type local:WpfUiDatePicker}}">
              <Setter Property="Height" Value="41" />
              <Setter Property="Padding" Value="12,0" />
              <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            </Style>
            <Style x:Key="MainReminderModeRadio" TargetType="{x:Type RadioButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid x:Name="Surface"
                          Background="{TemplateBinding Background}"
                          RenderTransformOrigin="0.5,0.5">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="9" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  Margin="9,0,0,0"
                                  VerticalAlignment="Center">
                        <Grid Width="16" Height="16">
                          <Ellipse x:Name="Ring"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource ControlBorderBrush}"
                                   StrokeThickness="2" />
                          <!-- #151：选中圆点/描边用焦点·强调轨语义色 ActiveBrush
                              （对编辑卡画布 3.27 ≥ 3:1 非文本门槛；IconAccentBrush 2.13 是装饰色）。 -->
                          <Ellipse x:Name="Dot"
                                   Width="7"
                                   Height="7"
                                   Fill="{DynamicResource ActiveBrush}"
                                   Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="6,0,9,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveHoverBrush}" />
                      </Trigger>
                      <!-- #152：补齐按压态，与键盘焦点同语言（环 ActiveBrush）。 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Surface" Property="RenderTransform">
                          <Setter.Value>
                            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="Surface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainReminderHelpButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeCaptionFontSize}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Surface"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="14" />
                      <Ellipse x:Name="Circle"
                               Width="19"
                               Height="19"
                               Stroke="{DynamicResource MutedBrush}"
                               StrokeThickness="1.6" />
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="?" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource ActiveHoverBrush}" />
                      </Trigger>
                      <!-- #152：帮助图标补齐按压（环 ActiveBrush）与禁用 0.45；聚焦说明见代码behind接线。 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Surface" Property="RenderTransform">
                          <Setter.Value>
                            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsEnabled" Value="False" />
                          <Condition Property="focus:ApplicationTheme.IsSystemContrast" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource SystemContrastControlBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemContrastDisabledTextBrush}" />
                        <Setter TargetName="Surface" Property="Opacity" Value="1" />
                      </MultiTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>

          <!-- 锚点 Canvas：只承载装饰层与工作台骨架，业务内容全部由骨架内的
               Grid / StackPanel / UniformGrid / ScrollViewer 承载（issue #135）。 -->
          <Canvas x:Name="MainContentSurface"
                  Width="864"
                  Height="1000"
                  Background="Transparent">
            <Canvas x:Name="CharacterBackgroundLayer"
                    Width="864"
                    Height="1000"
                    Panel.ZIndex="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Image x:Name="MyMelodyBackground" Canvas.Left="41" Canvas.Top="756" Width="226" Height="200" Stretch="Uniform" />
              <Image x:Name="CinnamorollBackground" Canvas.Left="289" Canvas.Top="785" Width="282" Height="163" Stretch="Uniform" />
              <Image x:Name="KuromiBackground" Canvas.Left="604" Canvas.Top="748" Width="200" Height="215" Stretch="Uniform" />
            </Canvas>

            <Canvas x:Name="CharacterPanelLayer"
                    Canvas.Left="28"
                    Canvas.Top="216"
                    Width="807"
                    Height="89"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Border x:Name="CharacterPanelSurface"
                      Canvas.Top="33"
                      Width="807"
                      Height="56"
                      BorderThickness="1"
                      CornerRadius="22,22,0,0">
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{DynamicResource CharacterPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CharacterLineBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked, ElementName=NotesTab}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NoteBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource NoteLineBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <Border x:Name="MyMelodyCharacterDock"
                      Canvas.Left="24"
                      Width="89"
                      Height="78"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="13"
                      ClipToBounds="True"><Image x:Name="MyMelodyPanelCharacter" Height="119" Stretch="Uniform" /></Border>
              <Border x:Name="CinnamorollCharacterDock"
                      Canvas.Left="334"
                      Canvas.Top="13"
                      Width="141"
                      Height="65"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="13"
                      ClipToBounds="True"><Image x:Name="CinnamorollPanelCharacter" Width="163" Stretch="Uniform" /></Border>
              <Border x:Name="KuromiCharacterDock"
                      Canvas.Left="694"
                      Width="89"
                      Height="78"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="13"
                      ClipToBounds="True"><Image x:Name="KuromiPanelCharacter" Height="119" Stretch="Uniform" /></Border>
            </Canvas>

            <!-- 工作台骨架：顶部身份区 / 命令栏 / 当前工作区主卡与列表区 / 底部动作区（issue #131 #135）。 -->
            <Grid x:Name="MainWorkbenchLayout"
                  Width="864"
                  Height="1000">
              <Grid.RowDefinitions>
                <RowDefinition Height="130" />
                <RowDefinition Height="86" />
                <RowDefinition Height="738" />
                <RowDefinition Height="46" />
              </Grid.RowDefinitions>

              <!-- 顶部身份区：标题 + 副标题 + 窗口控制 -->
              <Grid x:Name="MainIdentityZone" Grid.Row="0" Margin="30,35,16,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MainTitleZone">
                  <StackPanel Orientation="Horizontal">
                    <!-- 便签页目标图标题左侧的房子标识；倒计时页保持标题右侧心形（§12 各页对齐各自 AI 图）。 -->
                    <Path Width="33"
                          Height="30"
                          Margin="0,0,12,4"
                          VerticalAlignment="Center"
                          Data="M 16.5,2.25 L 30.75,13.88 L 27.38,13.88 L 27.38,24.38 C 27.38,26.03 26.03,27.38 24.38,27.38 L 8.62,27.38 C 6.98,27.38 5.62,26.03 5.62,24.38 L 5.62,13.88 L 2.25,13.88 Z M 12.75,27.38 L 12.75,18.75 C 12.75,17.92 13.42,17.25 14.25,17.25 L 18.75,17.25 C 19.58,17.25 20.25,17.92 20.25,18.75 L 20.25,27.38 Z"
                          Fill="{DynamicResource InkBrush}"
                          IsHitTestVisible="False">
                      <Path.Style>
                        <Style TargetType="{x:Type Path}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NotesTab}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="敏敏子的时光小屋"
                               FontSize="{DynamicResource TypeDisplayFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Path Width="24"
                          Height="21"
                          Margin="9,0,0,0"
                          VerticalAlignment="Center"
                          Data="M 12,19.88 C 5.62,15 1.5,10.65 1.5,6.45 C 1.5,3.3 3.9,1.35 6.38,1.35 C 8.7,1.35 10.8,2.92 12,5.1 C 13.2,2.92 15.3,1.35 17.62,1.35 C 20.1,1.35 22.5,3.3 22.5,6.45 C 22.5,10.65 18.38,15 12,19.88 Z"
                          Stroke="{DynamicResource IconAccentBrush}"
                          StrokeThickness="2"
                          StrokeLineJoin="Round"
                          IsHitTestVisible="False">
                      <Path.Style>
                        <Style TargetType="{x:Type Path}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CountdownTab}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </StackPanel>
                  <TextBlock Margin="0,4,0,0"
                             Text="重要时刻和今日努力，都在这里慢慢长大"
                             FontSize="{DynamicResource TypeBodyFontSize}"
                             Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <Grid x:Name="MainWindowControls" Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="11" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="TopmostCheck"
                            Grid.Column="0"
                            Width="98"
                            Height="36"
                            Margin="0,8,0,0"
                            Content="窗口置顶"
                            IsChecked="True"
                            FontSize="{DynamicResource TypeBodyFontSize}"
                            Style="{StaticResource MainTopmostCheck}"
                            VerticalContentAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                  <Button x:Name="MinimizeButton"
                          Grid.Column="2"
                          Width="42"
                          Height="43"
                          Style="{StaticResource MainIconButton}"
                          ToolTip="最小化"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- #154：窗铬改矢量路径，与悬浮窗头部同一几何（12x12 坐标、2px 圆头描边）。 -->
                    <Viewbox Width="13" Height="13" Margin="0,1,0,0">
                      <Path Data="M 2,10 L 12,10"
                            Fill="Transparent"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                    </Viewbox>
                  </Button>
                  <Button x:Name="CloseButton"
                          Grid.Column="4"
                          Width="42"
                          Height="43"
                          Foreground="{DynamicResource DangerBrush}"
                          Style="{StaticResource MainIconButton}"
                          ToolTip="关闭"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Viewbox Width="13" Height="13" Margin="0,1,0,0">
                      <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                            Fill="Transparent"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                    </Viewbox>
                  </Button>
                </Grid>
              </Grid>

              <!-- 命令栏：工作区页签 + 筛选 / 标签 / 数量 -->
              <Grid x:Name="MainCommandBarZone" Grid.Row="1" Margin="30,0,6,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="190"
                        Height="51"
                        Padding="3"
                        Background="{DynamicResource CardAltBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="10">
                  <Grid x:Name="MainWorkspaceTabHost">
                    <!-- #196：选中指示条只改变 RenderTransform，避免切换时重排同级页签。 -->
                    <Canvas x:Name="MainWorkspaceTabIndicatorLayer"
                            Panel.ZIndex="2"
                            IsHitTestVisible="False">
                      <Border x:Name="MainWorkspaceTabIndicator"
                              Width="1"
                              Height="3"
                              Background="{DynamicResource PinkAccentStrongBrush}"
                              CornerRadius="0"
                              Visibility="Collapsed" />
                    </Canvas>
                    <StackPanel Panel.ZIndex="1" Orientation="Horizontal">
                      <ToggleButton x:Name="CountdownTab"
                                    Width="99"
                                    Content="倒计时"
                                    Style="{StaticResource MainSegmentButton}" />
                      <ToggleButton x:Name="NotesTab"
                                    Width="82"
                                    Margin="2,0,0,0"
                                    Content="便签"
                                    Style="{StaticResource MainNotesSegmentButton}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <!-- 设置齿轮为矢量路径（与悬浮窗「设置」同为 6 齿，18x18 坐标系实心齿轮 + 同心孔，填充绑定按钮前景）。
                     原「⚙」文本字形在 v52–v57 参考帧里被裁得只剩一截：共享按钮左右 13 的内边距把 41 宽按钮的
                     内容区挤到 9 DIP，比图标还窄，所以 Padding 归零。 -->
                <Button x:Name="PreferencesButton" Grid.Column="1" Width="41" Height="41" Padding="0"
                        Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="显示设置" AutomationProperties.Name="打开显示设置"
                        Style="{StaticResource MainSecondaryButton}">
                  <Path Width="18"
                        Height="18"
