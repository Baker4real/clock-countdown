                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,12,0,0">
                            <TextBlock x:Name="MonthlySalaryLabel" Text="月薪（元）" Style="{StaticResource MainCompactFieldLabel}" />
                            <TextBox x:Name="MonthlySalary" Margin="0,3,0,0" Style="{StaticResource MainCompactTextInput}" />
                            <TextBlock x:Name="MonthlySalaryError" Margin="0,8,0,0" FontSize="{StaticResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                          </StackPanel>
                          <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,6,0">
                            <TextBlock x:Name="WorkStartLabel" Text="上班时间" Style="{StaticResource MainCompactFieldLabel}" />
                            <TextBox x:Name="WorkStart" Margin="0,3,0,0" Style="{StaticResource MainCompactTextInput}" />
                            <TextBlock x:Name="WorkStartError" Margin="0,8,0,0" FontSize="{StaticResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                          </StackPanel>
                          <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,12,0,0">
                            <TextBlock x:Name="WorkEndLabel" Text="下班时间" Style="{StaticResource MainCompactFieldLabel}" />
                            <TextBox x:Name="WorkEnd" Margin="0,3,0,0" Style="{StaticResource MainCompactTextInput}" />
                            <TextBlock x:Name="WorkEndError" Margin="0,8,0,0" FontSize="{StaticResource TypeCaptionFontSize}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                          </StackPanel>
                          <Button x:Name="SavePreferencesButton" Grid.Row="3" Grid.ColumnSpan="2" Width="104" Height="41"
                                  MinHeight="41" Margin="0,18,0,0" HorizontalAlignment="Right" Content="保存设置"
                                  Style="{StaticResource MainSecondarySolidButton}" />
                        </Grid>
                      </Border>
                    </Popup>
            <Popup x:Name="FilterPopup"
                   PlacementTarget="{Binding ElementName=FilterButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   focus:PopupMotionBehavior.IsEnabled="True"
                   PopupAnimation="None">
              <Border MinWidth="356"
                      MaxHeight="520"
                      Margin="0,6,0,0"
                      Padding="15"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="9">
                <ScrollViewer MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Text="标签匹配" FontSize="{DynamicResource TypeCaptionFontSize}" FontWeight="SemiBold" />
                  <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                    <ToggleButton x:Name="AnyTagMode" Content="任一匹配" Style="{DynamicResource FilterOptionButton}" />
                    <ToggleButton x:Name="AllTagMode" Margin="8,0,0,0" Content="全部匹配" Style="{DynamicResource FilterOptionButton}" />
                    <ToggleButton x:Name="UntaggedOnly" Margin="8,0,0,0" Content="无标签" Style="{DynamicResource FilterOptionButton}" />
                  </StackPanel>
                  <WrapPanel x:Name="FilterTagOptions" Margin="0,6,0,0" />
                  <StackPanel x:Name="CountdownFilterOptions" Margin="0,9,0,0">
                    <TextBlock Text="倒计时状态" FontWeight="SemiBold" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                      <ToggleButton x:Name="CountdownAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="CountdownActiveFilter" Margin="8,0,0,0" Content="未到期" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="CountdownExpiredFilter" Margin="8,0,0,0" Content="已到期" Style="{DynamicResource FilterOptionButton}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="NoteFilterOptions" Margin="0,9,0,0" Visibility="Collapsed">
                    <TextBlock Text="便签状态与日期" FontWeight="SemiBold" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                      <ToggleButton x:Name="NoteAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteActiveFilter" Margin="8,0,0,0" Content="未完成" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteCompletedFilter" Margin="8,0,0,0" Content="已完成" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteUndatedFilter" Margin="8,0,0,0" Content="未设日期" Style="{DynamicResource FilterOptionButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                      <!-- #153：筛选弹层的便签日期筛选有可见标签（字段标签 BodyBrush），不是无名空下拉。 -->
                      <TextBlock x:Name="NoteDateFilterLabel"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 Foreground="{DynamicResource BodyBrush}"
                                 Text="日期" />
                      <local:WpfUiDatePicker x:Name="NoteDateFilter" Width="216" />
                      <Button x:Name="ClearNoteDateFilter"
                              Width="56"
                              Margin="8,0,0,0"
                              Content="清除"
                              Style="{DynamicResource SecondaryButton}" />
                    </StackPanel>
                  </StackPanel>
                  <Button x:Name="ClearFilterButton"
                          Margin="0,9,0,0"
                          HorizontalAlignment="Right"
                          Content="重置筛选"
                          Style="{DynamicResource SecondaryButton}" />
                </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>

            <Popup x:Name="TagManagerPopup"
                   PlacementTarget="{Binding ElementName=TagManagerButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   focus:PopupMotionBehavior.IsEnabled="True"
                   PopupAnimation="None">
              <Border MinWidth="319"
                      MaxHeight="520"
                      Margin="0,6,0,0"
                      Padding="15"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="9">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="NewTagInputLabel"
                               Text="新标签名称"
                               FontSize="{DynamicResource TypeCaptionFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="NewTagInput" MaxLength="30" />
                      <Button x:Name="CreateTagButton"
                              Grid.Column="1"
                              Width="59"
                              Margin="6,0,0,0"
                              Content="新建"
                              Style="{DynamicResource PrimaryButton}" />
                    </Grid>
                  </StackPanel>
                  <ScrollViewer Grid.Row="1" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TagManagerRows" />
                  </ScrollViewer>
                  <TextBlock x:Name="TagManagerMessage"
                             Grid.Row="2"
                             Margin="2,6,2,0"
                             Foreground="{DynamicResource DangerBrush}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Popup>
          </Canvas>
        </Grid>
      </Canvas>
    </Grid>
    </ScrollViewer>
  </Grid>
</Window>
