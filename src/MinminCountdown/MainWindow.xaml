<Window x:Class="MinminCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="敏敏子倒计时"
        Width="760"
        Height="880"
        MinWidth="680"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Margin="28,20,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid x:Name="CharacterBackgroundLayer"
          Grid.RowSpan="4"
          Opacity="0.10"
          IsHitTestVisible="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="MyMelodyBackground" Grid.Column="0" Margin="4,100,4,70" Stretch="Uniform" />
      <Image x:Name="CinnamorollBackground" Grid.Column="1" Margin="4,100,4,70" Stretch="Uniform" />
      <Image x:Name="KuromiBackground" Grid.Column="2" Margin="4,100,4,70" Stretch="Uniform" />
    </Grid>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="敏敏子的时光小屋"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource InkBrush}" />
        <TextBlock Text="重要时刻和今日努力，都在这里慢慢长大"
                   Margin="0,5,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
      <CheckBox x:Name="TopmostCheck"
                Grid.Column="1"
                Margin="12,0,0,0"
                Content="窗口置顶"
                IsChecked="True"
                VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
      <Button x:Name="MinimizeButton"
              Grid.Column="2"
              Width="36"
              Margin="10,0,0,0"
              Content="−"
              Style="{DynamicResource IconButton}"
              ToolTip="最小化"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" />
      <Button x:Name="CloseButton"
              Grid.Column="3"
              Width="36"
              Margin="6,0,0,0"
              Content="×"
              Foreground="{DynamicResource DangerBrush}"
              Style="{DynamicResource IconButton}"
              ToolTip="关闭"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" />
    </Grid>

    <Grid Grid.Row="1" Margin="0,18,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Padding="4"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource PeachLineBrush}"
              BorderThickness="1"
              CornerRadius="12"
              HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="CountdownTab"
                        Width="78"
                        Content="倒计时"
                        Style="{DynamicResource SegmentButton}" />
          <ToggleButton x:Name="NotesTab"
                        Width="66"
                        Margin="3,0,0,0"
                        Content="便签"
                        Style="{DynamicResource SegmentButton}" />
        </StackPanel>
      </Border>
      <Button x:Name="FilterButton"
              Grid.Column="1"
              Width="84"
              Margin="8,0,0,0"
              Content="筛选"
              Style="{DynamicResource SecondaryButton}" />
      <Button x:Name="TagManagerButton"
              Grid.Column="2"
              Width="92"
              Margin="8,0,0,0"
              Content="标签"
              Style="{DynamicResource SecondaryButton}" />
      <TextBlock x:Name="RecordCountText"
                 Grid.Column="3"
                 Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource MutedBrush}" />

      <Popup x:Name="FilterPopup"
             Grid.ColumnSpan="4"
             PlacementTarget="{Binding ElementName=FilterButton}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade">
        <Border MinWidth="340"
                Margin="0,6,0,0"
                Padding="16"
                Background="{DynamicResource CanvasBrush}"
                BorderBrush="{DynamicResource PeachLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <StackPanel>
            <TextBlock Text="标签匹配" FontWeight="SemiBold" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
              <ToggleButton x:Name="AnyTagMode" Content="任一匹配" Style="{DynamicResource FilterOptionButton}" />
              <ToggleButton x:Name="AllTagMode" Margin="6,0,0,0" Content="全部匹配" Style="{DynamicResource FilterOptionButton}" />
              <ToggleButton x:Name="UntaggedOnly" Margin="6,0,0,0" Content="无标签" Style="{DynamicResource FilterOptionButton}" />
            </StackPanel>
            <WrapPanel x:Name="FilterTagOptions" Margin="0,8,0,0" />
            <StackPanel x:Name="CountdownFilterOptions" Margin="0,12,0,0">
              <TextBlock Text="倒计时状态" FontWeight="SemiBold" />
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ToggleButton x:Name="CountdownAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                <ToggleButton x:Name="CountdownActiveFilter" Margin="6,0,0,0" Content="未到期" Style="{DynamicResource FilterOptionButton}" />
                <ToggleButton x:Name="CountdownExpiredFilter" Margin="6,0,0,0" Content="已到期" Style="{DynamicResource FilterOptionButton}" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="NoteFilterOptions" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock Text="便签状态与日期" FontWeight="SemiBold" />
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ToggleButton x:Name="NoteAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                <ToggleButton x:Name="NoteActiveFilter" Margin="6,0,0,0" Content="未完成" Style="{DynamicResource FilterOptionButton}" />
                <ToggleButton x:Name="NoteCompletedFilter" Margin="6,0,0,0" Content="已完成" Style="{DynamicResource FilterOptionButton}" />
                <ToggleButton x:Name="NoteUndatedFilter" Margin="6,0,0,0" Content="未设日期" Style="{DynamicResource FilterOptionButton}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <DatePicker x:Name="NoteDateFilter" Width="190" />
                <Button x:Name="ClearNoteDateFilter"
                        Width="66"
                        Margin="6,0,0,0"
                        Content="清除"
                        Style="{DynamicResource SecondaryButton}" />
              </StackPanel>
            </StackPanel>
            <Button x:Name="ClearFilterButton"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Content="重置筛选"
                    Style="{DynamicResource SecondaryButton}" />
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="TagManagerPopup"
             Grid.ColumnSpan="4"
             PlacementTarget="{Binding ElementName=TagManagerButton}"
             Placement="Bottom"
             StaysOpen="False"
             AllowsTransparency="True"
             PopupAnimation="Fade">
        <Border MinWidth="370"
                MaxHeight="460"
                Margin="0,6,0,0"
                Padding="16"
                Background="{DynamicResource CanvasBrush}"
                BorderBrush="{DynamicResource PeachLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="NewTagInput" MaxLength="30" />
              <Button x:Name="CreateTagButton"
                      Grid.Column="1"
                      Width="72"
                      Margin="8,0,0,0"
                      Content="新建"
                      Style="{DynamicResource PrimaryButton}" />
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="TagManagerRows" />
            </ScrollViewer>
            <TextBlock x:Name="TagManagerMessage"
                       Grid.Row="2"
                       Margin="2,8,2,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Popup>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="CharacterPanelLayer"
            Grid.Row="0"
            Margin="0,0,0,8"
            ClipToBounds="False"
            IsHitTestVisible="False">
        <Border x:Name="CharacterPanelSurface"
                Margin="20,16,20,4"
                Background="{DynamicResource CharacterPanelBrush}"
                BorderBrush="{DynamicResource CharacterLineBrush}"
                BorderThickness="1"
                CornerRadius="12" />
        <Border x:Name="MyMelodyCharacterDock"
                Width="82"
                Height="72"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Background="{DynamicResource CharacterMyMelodyDockBrush}"
                BorderBrush="{DynamicResource CharacterLineBrush}"
                BorderThickness="1"
                CornerRadius="18">
          <Image x:Name="MyMelodyPanelCharacter"
                 Margin="0,-8,0,0"
                 Stretch="Uniform" />
        </Border>
        <Border x:Name="CinnamorollCharacterDock"
                Width="132"
                Height="62"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Panel.ZIndex="1"
                Background="{DynamicResource CharacterCinnamorollDockBrush}"
                BorderBrush="{DynamicResource CharacterLineBrush}"
                BorderThickness="1"
                CornerRadius="18">
          <Image x:Name="CinnamorollPanelCharacter"
                 Margin="-8,-10,-8,2"
                 Stretch="Uniform" />
        </Border>
        <Border x:Name="KuromiCharacterDock"
                Width="82"
                Height="72"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="1"
                Background="{DynamicResource CharacterKuromiDockBrush}"
                BorderBrush="{DynamicResource CharacterLineBrush}"
                BorderThickness="1"
                CornerRadius="18">
          <Image x:Name="KuromiPanelCharacter"
                 Margin="0,-8,0,0"
                 Stretch="Uniform" />
        </Border>
      </Grid>

      <Grid Grid.Row="1">
      <Grid x:Name="CountdownWorkspace">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="20"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource PeachLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CountdownEditorTitle" Text="新增倒计时" FontSize="17" FontWeight="SemiBold" />
            <Grid Grid.Row="1" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="名称" Style="{DynamicResource FieldLabel}" />
                <TextBox x:Name="CountdownName" MaxLength="30" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="截止日期" Style="{DynamicResource FieldLabel}" />
                <DatePicker x:Name="CountdownDate" Width="250" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="时" Style="{DynamicResource FieldLabel}" />
                <ComboBox x:Name="CountdownHour" Width="126" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="7,0,0,0">
                <TextBlock Text="分" Style="{DynamicResource FieldLabel}" />
                <ComboBox x:Name="CountdownMinute" Width="126" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="7,0,0,0">
                <TextBlock Text="秒" Style="{DynamicResource FieldLabel}" />
                <ComboBox x:Name="CountdownSecond" Width="126" />
              </StackPanel>
              <Button x:Name="SetNowButton"
                      Grid.Column="3"
                      Width="94"
                      Margin="9,18,0,0"
                      Content="设为现在"
                      Style="{DynamicResource SecondaryButton}" />
              <local:TagSelector x:Name="CountdownTags"
                                 Grid.Column="4"
                                 Margin="9,18,0,0"
                                 HorizontalAlignment="Stretch" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="CountdownMessage"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource DangerBrush}"
                         TextWrapping="Wrap" />
              <Button x:Name="CancelCountdownEdit"
                      Grid.Column="1"
                      Width="72"
                      Margin="8,0,0,0"
                      Content="取消"
                      Visibility="Collapsed"
                      Style="{DynamicResource SecondaryButton}" />
              <Button x:Name="SaveCountdownButton"
                      Grid.Column="2"
                      Width="112"
                      Margin="8,0,0,0"
                      Content="添加倒计时"
                      Style="{DynamicResource PrimaryButton}" />
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="18"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource PeachLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="1.25*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="显示精度" Style="{DynamicResource FieldLabel}" />
              <ComboBox x:Name="DisplayPrecision" MinWidth="96" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="月薪（元）" Style="{DynamicResource FieldLabel}" />
              <TextBox x:Name="MonthlySalary" MinWidth="112" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0">
              <TextBlock Text="上班时间" Style="{DynamicResource FieldLabel}" />
              <TextBox x:Name="WorkStart" MinWidth="96" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="10,0,0,0">
              <TextBlock Text="下班时间" Style="{DynamicResource FieldLabel}" />
              <TextBox x:Name="WorkEnd" MinWidth="96" />
            </StackPanel>
            <Button x:Name="SavePreferencesButton"
                    Grid.Column="4"
                    Width="92"
                    Margin="10,18,0,0"
                    Content="保存设置"
                    Style="{DynamicResource PrimaryButton}" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="CountdownRows" />
        </ScrollViewer>
      </Grid>

      <Grid x:Name="NotesWorkspace" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="20"
                Background="{DynamicResource NoteBrush}"
                BorderBrush="{DynamicResource NoteLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="NoteText" MaxLength="140" />
              <DatePicker x:Name="NoteDate" Grid.Column="1" Width="190" Margin="8,0,0,0" />
              <Button x:Name="SaveNoteButton"
                      Grid.Column="2"
                      Width="74"
                      Margin="8,0,0,0"
                      Content="添加"
                      Style="{DynamicResource PrimaryButton}" />
              <Button x:Name="CancelNoteEdit"
                      Grid.Column="3"
                      Width="66"
                      Margin="8,0,0,0"
                      Content="取消"
                      Visibility="Collapsed"
                      Style="{DynamicResource SecondaryButton}" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,9,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="NoteReminder" Width="124" />
              <ComboBox x:Name="NoteReminderInterval"
                        Grid.Column="1"
                        Width="116"
                        Margin="8,0,0,0"
                        Visibility="Collapsed" />
              <TextBox x:Name="CustomReminderMinutes"
                       Grid.Column="2"
                       Width="72"
                       Margin="8,0,0,0"
                       MaxLength="4"
                       Visibility="Collapsed" />
              <local:TagSelector x:Name="NoteTags"
                                 Grid.Column="3"
                                 Margin="8,0,0,0"
                                 HorizontalAlignment="Left" />
              <TextBox x:Name="NoteSearch"
                       Grid.Column="4"
                       Width="156"
                       Margin="8,0,0,0"
                       MaxLength="140" />
            </Grid>
            <Grid x:Name="NoteReminderSchedule"
                  Grid.Row="2"
                  Margin="0,9,0,0"
                  Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NoteReminderLabel"
                         Margin="2,0,8,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource InkBrush}"
                         Text="首次提醒" />
              <DatePicker x:Name="NoteReminderDate" Grid.Column="1" Width="190" />
              <ComboBox x:Name="NoteReminderHour" Grid.Column="2" Width="70" Margin="8,0,0,0" />
              <TextBlock Grid.Column="3" Margin="5,0" VerticalAlignment="Center" Text=":" />
              <ComboBox x:Name="NoteReminderMinute" Grid.Column="4" Width="70" />
              <TextBlock Grid.Column="5"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="北京时间" />
            </Grid>
            <TextBlock x:Name="NoteMessage"
                       Grid.Row="3"
                       Margin="2,8,2,0"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button x:Name="ToggleActiveNotes"
                    Content="未完成"
                    Visibility="Collapsed"
                    Style="{DynamicResource SecondaryButton}" />
            <StackPanel x:Name="ActiveNoteRows" />
            <Button x:Name="ToggleCompletedNotes"
                    Margin="0,8,0,0"
                    Content="已完成"
                    Visibility="Collapsed"
                    Style="{DynamicResource SecondaryButton}" />
            <StackPanel x:Name="CompletedNoteRows" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      </Grid>
    </Grid>

    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="NowText" Foreground="{DynamicResource MutedBrush}" />
      <TextBlock x:Name="StatusText"
                 Grid.Column="1"
                 MaxWidth="330"
                 Margin="12,0,0,0"
                 Foreground="{DynamicResource MutedBrush}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Window>
