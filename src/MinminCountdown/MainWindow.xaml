                            <Button x:Name="CancelNoteEdit"
                                    Grid.Column="6"
                                    Width="66"
                                    Height="68"
                                    Padding="8,0"
                                    Content="取消"
                                    Visibility="Collapsed"
                                    Style="{StaticResource MainSecondaryButton}" />
                          </Grid>
                          <Grid Grid.Row="2" x:Name="MainNoteSecondaryLabels" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="202" />
                              <ColumnDefinition Width="15" />
                              <ColumnDefinition Width="172" />
                              <ColumnDefinition Width="406" />
                              <ColumnDefinition Width="220" />
                              <ColumnDefinition Width="31" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                              <Path Width="18"
                                    Height="18"
                                    Data="M 9,2.2 C 6.2,2.2 4.2,4.4 4.2,7.2 L 4.2,10.4 L 2.8,12.8 L 15.2,12.8 L 13.8,10.4 L 13.8,7.2 C 13.8,4.4 11.8,2.2 9,2.2 Z M 7.2,14.6 A 1.9,1.9 0 0 0 10.8,14.6"
                                    Stroke="{DynamicResource IconAccentBrush}"
                                    StrokeThickness="1.6"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                              <TextBlock x:Name="NoteReminderModeLabel"
                                         Margin="8,0,0,0"
                                         Text="提醒规则"
                                         Style="{StaticResource MainCompactFieldLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                              <Path Width="18"
                                    Height="18"
                                    Data="M 2.5,3.5 L 2.5,9.2 C 2.5,10 2.8,10.8 3.4,11.4 L 11.6,19.6 C 12.7,20.7 14.4,20.7 15.5,19.6 L 19.6,15.5 C 20.7,14.4 20.7,12.7 19.6,11.6 L 11.4,3.4 C 10.8,2.8 10,2.5 9.2,2.5 L 3.5,2.5 C 2.9,2.5 2.5,2.9 2.5,3.5 Z M 7,7 L 7.02,7"
                                    Stroke="{DynamicResource IconAccentBrush}"
                                    StrokeThickness="1.8"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                              <TextBlock x:Name="NoteTagsLabel"
                                         Margin="8,0,0,0"
                                         Text="标签"
                                         Style="{StaticResource MainCompactFieldLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                              <!-- #154：去掉标签旁重复的第二枚搜索镜（输入框左缘已有 §4 合同图标，
                                   与悬浮窗「搜索便签」单一图标语言一致）。 -->
                              <TextBlock x:Name="NoteSearchLabel"
                                         Margin="8,0,0,0"
                                         Text="搜索便签"
                                         Style="{StaticResource MainCompactFieldLabel}" />
                            </StackPanel>
                          </Grid>
                          <Grid Grid.Row="3" x:Name="MainNoteSecondaryInputs" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="202" />
                              <ColumnDefinition Width="15" />
                              <ColumnDefinition Width="172" />
                              <ColumnDefinition Width="406" />
                              <ColumnDefinition Width="220" />
                              <ColumnDefinition Width="31" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ManageNoteReminderRulesButton"
                                    Grid.Column="0"
                                    Width="202"
                                    Height="69"
                                    Content="管理提醒规则"
                                    Style="{StaticResource MainSecondaryButton}" />
                            <local:TagSelector x:Name="NoteTags"
                                               Grid.Column="2"
                                               Width="172"
                                               Height="69" />
                            <Grid Grid.Column="4">
                              <TextBox x:Name="NoteSearch"
                                       Width="220"
                                       MinHeight="69"
                                       MaxLength="140"
                                       Padding="48,0,16,0" />
                              <!-- #154：输入框内搜索镜统一控件层描边语言（§4 单色描边、MutedBrush 1.6、
                                   圆头），与铅笔/日历字段图标同规格；不再是唯一的实心填充图标。 -->
                              <Path Width="20"
                                    Height="20"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Data="M 13.5,8 A 5.5,5.5 0 1 0 2.5,8 A 5.5,5.5 0 1 0 13.5,8 M 12.6,12.6 L 16.5,16.5"
                                    Stroke="{DynamicResource MutedBrush}"
                                    StrokeThickness="1.6"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    IsHitTestVisible="False" />
                              <TextBlock Margin="48,0,0,0"
                                         Height="28"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         FontSize="{DynamicResource TypeH2FontSize}"
                                         Foreground="{DynamicResource MutedBrush}"
                                         IsHitTestVisible="False"
                                         Text="搜索关键词…">
                                <TextBlock.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Text, ElementName=NoteSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Grid>
                          </Grid>
                          <TextBlock x:Name="NoteReminderRulesSummary"
                                     Grid.Row="4"
                                     Width="790"
                                     Margin="0,4,0,0"
                                     FontSize="{DynamicResource TypeBodyFontSize}"
                                     Foreground="{DynamicResource MutedBrush}"
                                     TextWrapping="Wrap"
                                     Text="不提醒" />
                          <TextBlock x:Name="NoteMessage"
                                     Grid.Row="5"
                                     Width="790"
                                     Margin="0,2,0,0"
                                     FontSize="{DynamicResource TypeBodyFontSize}"
                                     Foreground="{DynamicResource DangerBrush}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        </Border>
                      </Border>
                    </Grid>
                    <Grid Grid.Row="2" x:Name="NotesListCard">
                      <Border x:Name="NotesListSurface"
                              Background="{DynamicResource CardBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="1"
                              CornerRadius="16" />
                      <ScrollViewer x:Name="NotesListRegion"
                                  FocusVisualStyle="{StaticResource MainKeyboardFocusVisual}"
                                  Focusable="True"
                                  IsTabStop="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Margin="20,18,12,22">
                        <Grid x:Name="NotesStatusHeader" Margin="0,0,0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Padding="2"
                                  Background="Transparent"
                                  CornerRadius="17">
                            <Grid x:Name="NotesSegmentHost">
                              <!-- #196：状态分段与页签共用可中断的 160ms 指示条。 -->
                              <Canvas x:Name="NotesSegmentIndicatorLayer"
                                      Panel.ZIndex="2"
                                      IsHitTestVisible="False">
                                <Border x:Name="NotesSegmentIndicator"
                                        Width="1"
                                        Height="4"
                                        Background="{DynamicResource PeachRailBrush}"
                                        CornerRadius="2"
                                        Visibility="Collapsed" />
                              </Canvas>
                              <StackPanel Panel.ZIndex="1" Orientation="Horizontal">
                              <ToggleButton x:Name="ActiveNotesSegment"
                                            Height="48"
                                            Style="{StaticResource MainNoteSegmentButton}">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <Border x:Name="ActiveNotesSegmentRail"
                                          Width="4"
                                          Height="26"
                                          Margin="10,0,0,0"
                                          CornerRadius="2"
                                          VerticalAlignment="Center"
                                          Background="{DynamicResource PeachRailBrush}">
                                    <Border.Style>
                                      <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsChecked, ElementName=ActiveNotesSegment}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                  </Border>
                                  <TextBlock x:Name="ActiveNotesLabel"
                                             Grid.Column="1"
                                             Margin="10,0,0,0"
                                             FontSize="{DynamicResource TypeH2FontSize}"
                                             Text="未完成"
                                             VerticalAlignment="Center">
                                    <TextBlock.Style>
                                      <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsChecked, ElementName=ActiveNotesSegment}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <Border x:Name="ActiveNotesBadge"
                                          Grid.Column="2"
                                          MinWidth="34"
                                          Margin="12,0,14,0"
                                          Padding="9,2"
                                          CornerRadius="12"
                                          VerticalAlignment="Center">
                                    <Border.Style>
                                      <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource PeachBadgeMutedBrush}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsChecked, ElementName=ActiveNotesSegment}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PeachBadgeBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                    <!-- #156：分段裸数字不再作为独立内容控件朗读（SilentTextBlock）；
                                         数量语义由分段按钮可访问名「查看未完成便签，共 N 条」承担。 -->
                                    <local:SilentTextBlock x:Name="ActiveNotesCount"
                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                               Text="0"
                                               TextAlignment="Center"
                                               Typography.NumeralAlignment="Tabular">
                                      <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                          <!-- #148：徽章文字换绑正文可读色，白字对 PeachBadgeBrush 不达 4.5。 -->
                                          <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=ActiveNotesSegment}" Value="True">
                                              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </local:SilentTextBlock>
                                  </Border>
                                </Grid>
                              </ToggleButton>
                              <ToggleButton x:Name="CompletedNotesSegment"
                                            Height="48"
                                            Margin="2,0,0,0"
                                            Style="{StaticResource MainNoteSegmentButton}">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <Border x:Name="CompletedNotesSegmentRail"
                                          Width="4"
                                          Height="26"
                                          Margin="10,0,0,0"
                                          CornerRadius="2"
                                          VerticalAlignment="Center"
                                          Background="{DynamicResource PeachRailBrush}">
                                    <Border.Style>
                                      <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsChecked, ElementName=CompletedNotesSegment}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                  </Border>
                                  <TextBlock x:Name="CompletedNotesLabel"
                                             Grid.Column="1"
                                             Margin="10,0,0,0"
                                             FontSize="{DynamicResource TypeH2FontSize}"
                                             Text="已完成"
                                             VerticalAlignment="Center">
                                    <TextBlock.Style>
                                      <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsChecked, ElementName=CompletedNotesSegment}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <Border x:Name="CompletedNotesBadge"
                                          Grid.Column="2"
                                          MinWidth="34"
                                          Margin="12,0,14,0"
                                          Padding="9,2"
                                          CornerRadius="12"
                                          VerticalAlignment="Center">
                                    <Border.Style>
                                      <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource PeachBadgeMutedBrush}" />
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsChecked, ElementName=CompletedNotesSegment}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PeachBadgeBrush}" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>
                                    <!-- #156：分段裸数字不再作为独立内容控件朗读（SilentTextBlock）；
                                         数量语义由分段按钮可访问名「查看已完成便签，共 N 条」承担。 -->
                                    <local:SilentTextBlock x:Name="CompletedNotesCount"
                                               FontSize="{DynamicResource TypeBodyFontSize}"
                                               Text="0"
                                               TextAlignment="Center"
                                               Typography.NumeralAlignment="Tabular">
                                      <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                          <!-- #148：徽章文字换绑正文可读色，白字对 PeachBadgeBrush 不达 4.5。 -->
                                          <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=CompletedNotesSegment}" Value="True">
                                              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </local:SilentTextBlock>
                                  </Border>
                                </Grid>
                              </ToggleButton>
                              </StackPanel>
                            </Grid>
                          </Border>
                          <ComboBox x:Name="NoteGroupingSelector"
                                    Grid.Column="2"
                                    Width="188"
                                    Height="48"
                                    MinHeight="48"
                                    FontSize="{DynamicResource TypeBodyFontSize}"
                                    VerticalAlignment="Center"
                                    SelectedIndex="0"
                                    AutomationProperties.Name="按日期分组">
                            <ComboBoxItem Content="按日期分组" />
                          </ComboBox>
                        </Grid>
                        <StackPanel x:Name="ActiveNoteRows" Margin="8,6,0,0" />
                        <StackPanel x:Name="CompletedNoteRows" Margin="8,6,0,0" Visibility="Collapsed" />
                        <Grid x:Name="NotesEmptyStateContent"
                              MinHeight="360"
                              Visibility="Collapsed">
                          <StackPanel VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      MaxWidth="520">
                            <Image x:Name="NotesEmptyMascot"
                                   Width="92"
                                   Height="64"
                                   HorizontalAlignment="Center"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   Focusable="False" />
                            <TextBlock x:Name="EmptyNotesMessage"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource TypeH2FontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="还没有便签"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="EmptyNotesHint"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="{DynamicResource TypeBodyFontSize}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Text="先写下一件想记住的事。"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Visibility="Collapsed" />
                            <Button x:Name="AddEmptyNoteButton"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Content="添加便签"
                                    Style="{StaticResource MainSecondaryButton}"
                                    Visibility="Collapsed" />
                            <Button x:Name="ResetEmptyNotesFiltersButton"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Content="重置筛选"
                                    Visibility="Collapsed"
                                    Style="{StaticResource MainSecondaryButton}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                      </ScrollViewer>
                    </Grid>
                  </Grid>
                </Canvas>
              </Grid>

              <!-- 底部动作区：北京时间与状态。#151：状态栏消费状态条表面（StatusBarBrush），
                   错误字在该表面上达信息文本对比（DangerBrush 实测 4.83 ≥ 4.5）。 -->
              <Grid x:Name="MainStatusBarZone" Grid.Row="3" Margin="40,10,45,0" VerticalAlignment="Top">
                <Border x:Name="MainStatusBarSurface"
                        Background="{DynamicResource StatusBarBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusOverlay}"
                        Padding="14,8">
                <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NowText"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           MaxWidth="320"
                           FontSize="{DynamicResource TypeBodyFontSize}"
                           Foreground="{DynamicResource MutedBrush}"
                           FocusVisualStyle="{StaticResource MainKeyboardFocusVisual}"
                           Focusable="True"
                           KeyboardNavigation.IsTabStop="True"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />
                <!-- #155：最近一次删除的短时「撤销」入口；常态 Collapsed，状态条默认构图与 v22 帧一致。 -->
                <Button x:Name="MainStatusUndoButton"
                        Grid.Column="2"
                        MinWidth="56"
                        MinHeight="28"
                        Margin="12,0,0,0"
                        Padding="10,0"
                        Content="撤销"
                        Style="{DynamicResource SecondaryButton}"
                        Visibility="Collapsed" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                  <Path Width="18"
                        Height="18"
                        Data="M 6.2,9 A 3.6,3.6 0 1 0 13.4,9 A 3.6,3.6 0 1 0 6.2,9 Z M 9.8,0.8 L 9.8,2.4 M 9.8,15.6 L 9.8,17.2 M 0.8,9.8 L 2.4,9.8 M 15.6,9.8 L 17.2,9.8 M 3.2,3.2 L 4.4,4.4 M 15.2,15.2 L 16.4,16.4 M 16.4,3.2 L 15.2,4.4 M 4.4,15.2 L 3.2,16.4"
                        Stroke="{DynamicResource IconAccentBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                  <TextBlock x:Name="MainThemeCaption"
                             Margin="8,0,0,0"
                             Text="当前主题：日间"
                             FontSize="{DynamicResource TypeBodyFontSize}"
                             Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" />
                </StackPanel>
                </Grid>
                </Border>
              </Grid>
            </Grid>

            <Popup x:Name="FilterPopup"
                   PlacementTarget="{Binding ElementName=FilterButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   focus:PopupMotionBehavior.IsEnabled="True"
                   PopupAnimation="None">
              <Border MinWidth="480"
                      MaxHeight="520"
                      Margin="0,8,0,0"
                      Padding="20"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="12">
                <ScrollViewer MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Text="标签匹配" FontSize="{DynamicResource TypeBodyFontSize}" FontWeight="SemiBold" />
                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <ToggleButton x:Name="AnyTagMode" Content="任一匹配" Style="{DynamicResource FilterOptionButton}" />
                    <ToggleButton x:Name="AllTagMode" Margin="8,0,0,0" Content="全部匹配" Style="{DynamicResource FilterOptionButton}" />
                    <ToggleButton x:Name="UntaggedOnly" Margin="8,0,0,0" Content="无标签" Style="{DynamicResource FilterOptionButton}" />
                  </StackPanel>
                  <WrapPanel x:Name="FilterTagOptions" Margin="0,8,0,0" />
                  <StackPanel x:Name="CountdownFilterOptions" Margin="0,12,0,0">
                    <TextBlock Text="倒计时状态" FontWeight="SemiBold" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <ToggleButton x:Name="CountdownAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="CountdownActiveFilter" Margin="8,0,0,0" Content="未到期" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="CountdownExpiredFilter" Margin="8,0,0,0" Content="已到期" Style="{DynamicResource FilterOptionButton}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="NoteFilterOptions" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="便签状态与日期" FontWeight="SemiBold" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <ToggleButton x:Name="NoteAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteActiveFilter" Margin="8,0,0,0" Content="未完成" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteCompletedFilter" Margin="8,0,0,0" Content="已完成" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteUndatedFilter" Margin="8,0,0,0" Content="未设日期" Style="{DynamicResource FilterOptionButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <!-- #153：筛选弹层的便签日期筛选有可见标签（字段标签 BodyBrush），不是无名空下拉。 -->
                      <TextBlock x:Name="NoteDateFilterLabel"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 Foreground="{DynamicResource BodyBrush}"
                                 Text="日期" />
                      <local:WpfUiDatePicker x:Name="NoteDateFilter" Width="230" />
                      <Button x:Name="ClearNoteDateFilter"
                              Width="76"
                              Margin="8,0,0,0"
                              Content="清除"
                              Style="{DynamicResource SecondaryButton}" />
                    </StackPanel>
                  </StackPanel>
                  <Button x:Name="ClearFilterButton"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Right"
                          Content="重置筛选"
                          Style="{DynamicResource SecondaryButton}" />
                </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>

            <Popup x:Name="TagManagerPopup"
                   PlacementTarget="{Binding ElementName=TagManagerButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   focus:PopupMotionBehavior.IsEnabled="True"
                   PopupAnimation="None">
              <Border MinWidth="430"
                      MaxHeight="520"
                      Margin="0,8,0,0"
                      Padding="20"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="NewTagInputLabel"
                               Text="新标签名称"
                               FontSize="{DynamicResource TypeBodyFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="NewTagInput" MaxLength="30" />
                      <Button x:Name="CreateTagButton"
                              Grid.Column="1"
                              Width="80"
                              Margin="8,0,0,0"
                              Content="新建"
                              Style="{DynamicResource PrimaryButton}" />
                    </Grid>
                  </StackPanel>
                  <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TagManagerRows" />
                  </ScrollViewer>
                  <TextBlock x:Name="TagManagerMessage"
                             Grid.Row="2"
                             Margin="2,8,2,0"
                             Foreground="{DynamicResource DangerBrush}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Popup>
          </Canvas>
        </Grid>
      </Canvas>
    </Grid>
  </Grid>
</Window>
