<Window x:Class="MinminCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        xmlns:focus="clr-namespace:MinminCountdown"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="敏敏子倒计时"
        Width="1165"
        Height="1350"
        MinWidth="1165"
        MinHeight="1350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <Style x:Key="MainKeyboardFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <!-- #152：常规键盘焦点为 2px 暖边（§13.3 FocusBorderThickness），不再是 3px 第二套描边。 -->
            <Border Margin="-2"
                    BorderBrush="{DynamicResource ActiveBrush}"
                    BorderThickness="2"
                    CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource BackgroundBrush}">
    <!-- 1165 x 1350 is the real DIP layout.  The named grid is retained as the
         reference surface and popup clipping root; it no longer performs a
         non-integer Viewbox transform. -->
    <Grid x:Name="MainScaleViewport"
          Width="1165"
          Height="1350"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          ClipToBounds="True">
      <Canvas x:Name="MainLayoutSurface"
              Width="1165"
              Height="1350"
              ClipToBounds="True">
        <Canvas x:Name="MainReferenceDecorationLayer"
                Width="1165"
                Height="1350"
                Panel.ZIndex="1"
                IsHitTestVisible="False">
          <Image x:Name="CountdownReferenceDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
          <Image x:Name="NotesReferenceDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
        </Canvas>

        <Grid x:Name="MainContentProjection"
              Width="1165"
              Height="1350"
              Panel.ZIndex="2"
              TextElement.FontSize="{DynamicResource TypeBodyFontSize}"
              Background="Transparent">
          <Grid.Resources>
            <Style x:Key="MainFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource FieldLabel}">
              <Setter Property="Margin" Value="0" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            </Style>
            <Style x:Key="MainSecondaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style x:Key="MainNoteSegmentButton" TargetType="{x:Type ToggleButton}">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                          focus:MotionBehavior.CheckedBackgroundResourceKey="PeachTintBrush">
                      <!-- #154：激活胶囊短边一半全圆角——环包按钮高 48 → 24；Surface 高 48-2×2=44 → 22。 -->
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="24" />
                      <Border x:Name="Surface"
                              Margin="2"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="Transparent"
                              BorderThickness="1"
                              CornerRadius="22"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <!-- #194：选中底色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：页签悬停边色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteDateDisclosureButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="6,4" />
              <Setter Property="MinHeight" Value="42" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="7">
                        <Border x:Name="Surface"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                RenderTransformOrigin="0.5,0.5">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                        </Border>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：日期披露悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <!-- #152：按压与键盘焦点同语言（环 ActiveBrush），替代原 Opacity 0.9；补齐禁用 0.45。 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainPrimaryButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
              <Setter Property="Background" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="18,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #152：主按钮焦点例外沿用暖粉 MainActionFocusBrush；改常驻 2px 透明环变色，
                       悬停/按压/焦点都不再改 BorderThickness，内容不因状态位移。 -->
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="MainActionHoverBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="MainActionHoverBrush"
                          focus:MotionBehavior.PressedBackgroundResourceKey="MainActionPressedBrush">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="16" />
                      <Border x:Name="Surface"
                              Margin="2"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="14"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：主行动悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <!-- #194：按压底色与缩放由 MotionBehavior 插值。 -->
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <!-- #151：次级实心按钮（「保存设置」）——珊瑚语义底 + 主文字色（白字实测 2.77 不达标），
                 每页唯一实心主行动仍是 MainPrimaryButton；本样式不是主行动角色。 -->
            <Style x:Key="MainSecondarySolidButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Background" Value="{DynamicResource CoralActionBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource CoralActionBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Padding" Value="18,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #152：次级实心按钮改常驻 2px 透明环；环与珊瑚底之间留 1px 间隙，
                       ActiveBrush 环对间隙/编辑卡浅色实测 ≥3:1（直接贴珊瑚底仅 1.3 不达非文本门槛）。 -->
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="16" />
                      <Border x:Name="Surface"
                              Margin="3"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="13"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：次级行动悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainSegmentButton" TargetType="{x:Type ToggleButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Height" Value="60" />
              <Setter Property="Padding" Value="18,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #152：页签改常驻 2px 透明环 + 1px 间隙；选中粉底（PinkTintBrush）上
                       ActiveBrush 环不再直接贴粉底（实测 2.90 <3:1），环对容器/间隙浅色 ≥3:1。 -->
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface"
                          Background="Transparent"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                          focus:MotionBehavior.CheckedBackgroundResourceKey="PinkTintBrush"
                          focus:MotionBehavior.CheckedBorderBrushResourceKey="PinkTintBrush">
                      <!-- #154：激活胶囊短边一半全圆角——环包按钮高 60 → 30；Surface 高 60-2×3=54 → 27。 -->
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="30" />
                      <Border x:Name="Surface"
                              Margin="3"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="27"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：分段悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNotesSegmentButton"
                   TargetType="{x:Type ToggleButton}"
                   BasedOn="{StaticResource MainSegmentButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <!-- #152：未选中「便签」页签悬停改「边换 ActiveBrush」，不复用选中实心底 PeachTintBrush；
                       按压/焦点与键盘焦点同语言（环 ActiveBrush），补齐禁用 0.45。 -->
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface"
                          focus:MotionBehavior.IsEnabled="True"
                          focus:MotionBehavior.HoverBackgroundResourceKey="CardAltBrush"
                          focus:MotionBehavior.HoverBorderBrushResourceKey="ActiveHoverBrush"
                          focus:MotionBehavior.CheckedBackgroundResourceKey="PinkTintBrush"
                          focus:MotionBehavior.CheckedBorderBrushResourceKey="PinkTintBrush">
                      <!-- #154：同 MainSegmentButton——短边一半全圆角（环 30 / Surface 高 54 → 27）。 -->
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="30" />
                      <Border x:Name="Surface"
                              Margin="3"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="27"
                              Padding="{TemplateBinding Padding}"
                              RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <!-- #194：便签页签悬停色由 MotionBehavior 插值。 -->
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainIconButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource IconButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="MainTopmostCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Surface" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Box"
                              Width="26"
                              Height="26"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="8"
                              VerticalAlignment="Center">
                        <Path x:Name="Tick"
                              Width="15"
                              Height="11"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,5 L 6,10 L 14,1"
                              Visibility="Collapsed" />
                      </Border>
                      <ContentPresenter Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <!-- #152：置顶焦点例外沿用暖粉 MainActionFocusBrush；边框常驻 FocusBorderThickness，
                       焦点只换色不再从 1px 加粗，不再叠 FocusVisualStyle 第二套描边。 -->
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteCompletionCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <!-- #152/#208：真实 DIP 命中槽位 38（≥ 桌面紧凑下限 24），
                         可见勾选框保持 24 设计坐标居中；边框常驻 2px、焦点只换色。 -->
                    <Grid x:Name="Surface" Width="38" Height="38" Background="Transparent">
                      <Border x:Name="Box"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="{DynamicResource FocusBorderThickness}"
                              CornerRadius="6">
                        <Path x:Name="Tick"
                              Width="14"
                              Height="10"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,5 L 5,9 L 13,1"
                              Visibility="Collapsed" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style TargetType="{x:Type local:WpfUiDatePicker}"
                   BasedOn="{StaticResource {x:Type DatePicker}}">
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
            </Style>
            <Style x:Key="MainCompactFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource MainFieldLabel}">
              <!-- #197：字段标签统一 16px SemiBold。 -->
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
            </Style>
            <Style x:Key="MainCompactTextInput"
                   TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
              <!-- #151：输入面使用白纸面板色，与页面画布分开（§4 输入框底 PanelBrush）。 -->
              <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            </Style>
            <Style x:Key="MainCompactSelectionInput"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
              <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            </Style>
            <Style x:Key="MainCompactDateInput"
                   TargetType="{x:Type local:WpfUiDatePicker}"
                   BasedOn="{StaticResource {x:Type local:WpfUiDatePicker}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
              <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            </Style>
            <Style x:Key="MainReminderModeRadio" TargetType="{x:Type RadioButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="FontSize" Value="{DynamicResource TypeH2FontSize}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid x:Name="Surface"
                          Background="{TemplateBinding Background}"
                          RenderTransformOrigin="0.5,0.5">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="12" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                          <Ellipse x:Name="Ring"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource PeachLineBrush}"
                                   StrokeThickness="2" />
                          <!-- #151：选中圆点/描边用焦点·强调轨语义色 ActiveBrush
                              （对编辑卡画布 3.27 ≥ 3:1 非文本门槛；IconAccentBrush 2.13 是装饰色）。 -->
                          <Ellipse x:Name="Dot"
                                   Width="10"
                                   Height="10"
                                   Fill="{DynamicResource ActiveBrush}"
                                   Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,12,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <!-- #152：补齐按压态，与键盘焦点同语言（环 ActiveBrush）。 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Surface" Property="RenderTransform">
                          <Setter.Value>
                            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainReminderHelpButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="{DynamicResource TypeBodyFontSize}" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Surface"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="19" />
                      <Ellipse x:Name="Circle"
                               Width="26"
                               Height="26"
                               Stroke="{DynamicResource MutedBrush}"
                               StrokeThickness="1.6" />
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="?" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource ActiveHoverBrush}" />
                      </Trigger>
                      <!-- #152：帮助图标补齐按压（环 ActiveBrush）与禁用 0.45；聚焦说明见代码behind接线。 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Surface" Property="RenderTransform">
                          <Setter.Value>
                            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <MultiTrigger>
                        <MultiTrigger.Conditions>
                          <Condition Property="IsKeyboardFocused" Value="True" />
                          <Condition Property="focus:FocusVisualState.IsKeyboardFocusVisible" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </MultiTrigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>

          <!-- 锚点 Canvas：只承载装饰层与工作台骨架，业务内容全部由骨架内的
               Grid / StackPanel / UniformGrid / ScrollViewer 承载（issue #135）。 -->
          <Canvas x:Name="MainContentSurface"
                  Width="1165"
                  Height="1350"
                  Background="Transparent">
            <Canvas x:Name="CharacterBackgroundLayer"
                    Width="1165"
                    Height="1350"
                    Panel.ZIndex="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Image x:Name="MyMelodyBackground" Canvas.Left="55" Canvas.Top="1020" Width="305" Height="270" Stretch="Uniform" />
              <Image x:Name="CinnamorollBackground" Canvas.Left="390" Canvas.Top="1060" Width="380" Height="220" Stretch="Uniform" />
              <Image x:Name="KuromiBackground" Canvas.Left="815" Canvas.Top="1010" Width="270" Height="290" Stretch="Uniform" />
            </Canvas>

            <Canvas x:Name="CharacterPanelLayer"
                    Canvas.Left="38"
                    Canvas.Top="292"
                    Width="1088"
                    Height="120"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Border x:Name="CharacterPanelSurface"
                      Canvas.Top="45"
                      Width="1088"
                      Height="75"
                      BorderThickness="1"
                      CornerRadius="30,30,0,0">
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{DynamicResource CharacterPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CharacterLineBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked, ElementName=NotesTab}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NoteBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource NoteLineBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <Border x:Name="MyMelodyCharacterDock"
                      Canvas.Left="32"
                      Width="120"
                      Height="105"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="MyMelodyPanelCharacter" Height="160" Stretch="Uniform" /></Border>
              <Border x:Name="CinnamorollCharacterDock"
                      Canvas.Left="450"
                      Canvas.Top="18"
                      Width="190"
                      Height="88"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="CinnamorollPanelCharacter" Width="220" Stretch="Uniform" /></Border>
              <Border x:Name="KuromiCharacterDock"
                      Canvas.Left="936"
                      Width="120"
                      Height="105"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="KuromiPanelCharacter" Height="160" Stretch="Uniform" /></Border>
            </Canvas>

            <!-- 工作台骨架：顶部身份区 / 命令栏 / 当前工作区主卡与列表区 / 底部动作区（issue #131 #135）。 -->
            <Grid x:Name="MainWorkbenchLayout"
                  Width="1165"
                  Height="1350">
              <Grid.RowDefinitions>
                <RowDefinition Height="176" />
                <RowDefinition Height="116" />
                <RowDefinition Height="996" />
                <RowDefinition Height="62" />
              </Grid.RowDefinitions>

              <!-- 顶部身份区：标题 + 副标题 + 窗口控制 -->
              <Grid x:Name="MainIdentityZone" Grid.Row="0" Margin="40,47,22,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MainTitleZone">
                  <StackPanel Orientation="Horizontal">
                    <!-- 便签页目标图标题左侧的房子标识；倒计时页保持标题右侧心形（§12 各页对齐各自 AI 图）。 -->
                    <Path Width="44"
                          Height="40"
                          Margin="0,0,16,6"
                          VerticalAlignment="Center"
                          Data="M 22,3 L 41,18.5 L 36.5,18.5 L 36.5,32.5 C 36.5,34.7 34.7,36.5 32.5,36.5 L 11.5,36.5 C 9.3,36.5 7.5,34.7 7.5,32.5 L 7.5,18.5 L 3,18.5 Z M 17,36.5 L 17,25 C 17,23.9 17.9,23 19,23 L 25,23 C 26.1,23 27,23.9 27,25 L 27,36.5 Z"
                          Fill="{DynamicResource InkBrush}"
                          IsHitTestVisible="False">
                      <Path.Style>
                        <Style TargetType="{x:Type Path}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=NotesTab}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                    <TextBlock Text="敏敏子的时光小屋"
                               FontSize="{DynamicResource TypeDisplayFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Path Width="32"
                          Height="28"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Data="M 16,26.5 C 7.5,20 2,14.2 2,8.6 C 2,4.4 5.2,1.8 8.5,1.8 C 11.6,1.8 14.4,3.9 16,6.8 C 17.6,3.9 20.4,1.8 23.5,1.8 C 26.8,1.8 30,4.4 30,8.6 C 30,14.2 24.5,20 16,26.5 Z"
                          Stroke="{DynamicResource IconAccentBrush}"
                          StrokeThickness="2.6"
                          StrokeLineJoin="Round"
                          IsHitTestVisible="False">
                      <Path.Style>
                        <Style TargetType="{x:Type Path}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CountdownTab}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </StackPanel>
                  <TextBlock Margin="0,6,0,0"
                             Text="重要时刻和今日努力，都在这里慢慢长大"
                             FontSize="{DynamicResource TypeH2FontSize}"
                             Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <Grid x:Name="MainWindowControls" Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="DayThemeBadge"
                          Grid.Column="0"
                          Height="48"
                          Margin="0,11,0,0"
                          Padding="16,0"
                          VerticalAlignment="Top"
                          Background="{DynamicResource CardBrush}"
                          BorderBrush="{DynamicResource PeachLineBrush}"
                          BorderThickness="1"
                          CornerRadius="14"
                          Focusable="False"
                          IsHitTestVisible="False"
                          AutomationProperties.Name="当前主题：日间">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Path Width="22"
                            Height="22"
                            Data="M 6.2,11 A 4.8,4.8 0 1 0 15.8,11 A 4.8,4.8 0 1 0 6.2,11 Z M 11,0.8 L 11,3 M 11,19 L 11,21.2 M 0.8,11 L 3,11 M 19,11 L 21.2,11 M 3.8,3.8 L 5.4,5.4 M 16.6,16.6 L 18.2,18.2 M 18.2,3.8 L 16.6,5.4 M 5.4,16.6 L 3.8,18.2"
                            Stroke="{DynamicResource IconAccentBrush}"
                            StrokeThickness="1.7"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            VerticalAlignment="Center" />
                      <TextBlock Margin="9,0,0,0"
                                 Text="日间"
                                 VerticalAlignment="Center"
                                 FontSize="{DynamicResource TypeH2FontSize}"
                                 Foreground="{DynamicResource BodyBrush}" />
                    </StackPanel>
                  </Border>
                  <CheckBox x:Name="TopmostCheck"
                            Grid.Column="2"
                            Width="132"
                            Height="48"
                            Margin="0,11,0,0"
                            Content="窗口置顶"
                            IsChecked="True"
                            FontSize="{DynamicResource TypeH2FontSize}"
                            Style="{StaticResource MainTopmostCheck}"
                            VerticalContentAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                  <Button x:Name="MinimizeButton"
                          Grid.Column="4"
                          Width="57"
                          Height="58"
                          Style="{StaticResource MainIconButton}"
                          ToolTip="最小化"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- #154：窗铬改矢量路径，与悬浮窗头部同一几何（12x12 坐标、2px 圆头描边）。 -->
                    <Viewbox Width="18" Height="18" Margin="0,1,0,0">
                      <Path Data="M 2,10 L 12,10"
                            Fill="Transparent"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                    </Viewbox>
                  </Button>
                  <Button x:Name="CloseButton"
                          Grid.Column="6"
                          Width="57"
                          Height="58"
                          Foreground="{DynamicResource DangerBrush}"
                          Style="{StaticResource MainIconButton}"
                          ToolTip="关闭"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Viewbox Width="18" Height="18" Margin="0,1,0,0">
                      <Path Data="M 2,2 L 12,12 M 12,2 L 2,12"
                            Fill="Transparent"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                    </Viewbox>
                  </Button>
                </Grid>
              </Grid>

              <!-- 命令栏：工作区页签 + 筛选 / 标签 / 数量 -->
              <Grid x:Name="MainCommandBarZone" Grid.Row="1" Margin="40,0,8,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="11" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="255"
                        Height="69"
                        Padding="4"
                        Background="{DynamicResource CardAltBrush}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="14">
                  <Grid x:Name="MainWorkspaceTabHost">
                    <!-- #196：选中指示条只改变 RenderTransform，避免切换时重排同级页签。 -->
                    <Canvas x:Name="MainWorkspaceTabIndicatorLayer"
                            Panel.ZIndex="2"
                            IsHitTestVisible="False">
                      <Border x:Name="MainWorkspaceTabIndicator"
                              Width="1"
                              Height="4"
                              Background="{DynamicResource PinkAccentStrongBrush}"
                              CornerRadius="2"
                              Visibility="Collapsed" />
                    </Canvas>
                    <StackPanel Panel.ZIndex="1" Orientation="Horizontal">
                      <ToggleButton x:Name="CountdownTab"
                                    Width="133"
                                    Content="倒计时"
                                    Style="{StaticResource MainSegmentButton}" />
                      <ToggleButton x:Name="NotesTab"
                                    Width="111"
                                    Margin="2,0,0,0"
                                    Content="便签"
                                    Style="{StaticResource MainNotesSegmentButton}" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Button x:Name="FilterButton"
                        Grid.Column="2"
                        Width="133"
                        Height="69"
                        Style="{StaticResource MainSecondaryButton}">
                  <StackPanel Orientation="Horizontal">
                    <!-- #154：漏斗改实心填充（InkBrush）——1.8px 描边漏斗在现役 Aliased 确定性捕获口径下
                         对角笔画消失、按钮只剩「筛选」两字（v22 实证）；实心字形任何栅格化下都可识别。
                         同色描边只做边缘平滑。 -->
                    <Path Width="22"
                          Height="22"
                          Data="M 2.5,4 L 19.5,4 L 13.5,11.5 L 13.5,18 L 8.5,15.5 L 8.5,11.5 Z"
                          Fill="{DynamicResource InkBrush}"
                          Stroke="{DynamicResource InkBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,0,0"
                               x:Name="FilterButtonText"
                               Text="筛选"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="TagManagerButton"
                        Grid.Column="4"
                        Width="132"
                        Height="69"
                        Style="{StaticResource MainSecondaryButton}">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="22"
                          Height="22"
                          Data="M 2.5,3.5 L 2.5,9.2 C 2.5,10 2.8,10.8 3.4,11.4 L 11.6,19.6 C 12.7,20.7 14.4,20.7 15.5,19.6 L 19.6,15.5 C 20.7,14.4 20.7,12.7 19.6,11.6 L 11.4,3.4 C 10.8,2.8 10,2.5 9.2,2.5 L 3.5,2.5 C 2.9,2.5 2.5,2.9 2.5,3.5 Z M 7,7 L 7.02,7"
                          Stroke="{DynamicResource InkBrush}"
                          StrokeThickness="1.8"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,0,0"
                               Text="标签"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Border Grid.Column="6"
                        Height="48"
                        Margin="0,11,0,0"
                        Padding="14,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource PeachLineBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="20"
                          Height="20"
                          Data="M 4,2.5 L 16,2.5 C 16.8,2.5 17.5,3.2 17.5,4 L 17.5,16 C 17.5,16.8 16.8,17.5 16,17.5 L 4,17.5 C 3.2,17.5 2.5,16.8 2.5,16 L 2.5,4 C 2.5,3.2 3.2,2.5 4,2.5 Z M 6,7 L 14,7 M 6,11 L 14,11 M 6,15 L 11,15"
                          Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="RecordCountText"
                               Margin="9,0,0,0"
                               FontSize="{DynamicResource TypeH2FontSize}"
                               Foreground="{DynamicResource BodyBrush}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 当前工作区主卡 + 列表/管理区 -->
              <Grid x:Name="MainWorkspaceZone" Grid.Row="2">
                <Canvas x:Name="CountdownWorkspace"
                        Width="1165"
                        Height="996">
                  <Grid x:Name="CountdownWorkspaceBody"
                        Margin="38,110,39,0"
                        Width="1088"
                        Height="886">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="384" />
                      <RowDefinition Height="24" />
                      <RowDefinition Height="176" />
                      <RowDefinition Height="22" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CountdownWorkspaceBackdrop"
                            Grid.Row="0"
                            Grid.RowSpan="6"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource PeachLineBrush}"
                            BorderThickness="0"
                            CornerRadius="16"
                            IsHitTestVisible="False" />
                    <Border x:Name="CountdownEditorSurface"
                            Grid.Row="0"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource PeachLineBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                      <Grid x:Name="CountdownEditorCard" Margin="35,30,35,26">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock x:Name="CountdownEditorTitle"
                                     Text="新增倒计时"
                                     FontSize="{StaticResource TypeH1FontSize}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource InkBrush}" />
                          <!-- #154：原「每一个期待…」手写体已迁出表单（CountdownWorkspace 装饰层），
                               不再作为标题行列成员参与表单测量；用户故事 #147-55「只是情绪，不是布局成员」。 -->
