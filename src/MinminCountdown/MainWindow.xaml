<Window x:Class="MinminCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="敏敏子倒计时"
        Width="760"
        Height="880"
        MinWidth="760"
        MinHeight="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <Style x:Key="MainKeyboardFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3"
                    BorderBrush="{DynamicResource ActiveBrush}"
                    BorderThickness="3"
                    CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource BackgroundBrush}">
    <Viewbox x:Name="MainScaleViewport"
             Stretch="Uniform"
             StretchDirection="Both">
      <!-- 1165 x 1350 设计坐标锚点：只承担 Viewbox 缩放原点与 Popup 裁剪基准，
           不参与业务内容的布局测量（issue #135）。 -->
      <Canvas x:Name="MainLayoutSurface"
              Width="1165"
              Height="1350"
              ClipToBounds="True">
        <Canvas x:Name="MainReferenceDecorationLayer"
                Width="1165"
                Height="1350"
                Panel.ZIndex="1"
                IsHitTestVisible="False">
          <Image x:Name="CountdownReferenceDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
          <Image x:Name="NotesReferenceDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
        </Canvas>

        <Grid x:Name="MainContentProjection"
              Width="1165"
              Height="1350"
              Panel.ZIndex="2"
              TextElement.FontSize="20"
              Background="Transparent">
          <Grid.Resources>
            <Style x:Key="MainFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource FieldLabel}">
              <Setter Property="Margin" Value="0" />
              <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="MainSecondaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style x:Key="MainNoteSegmentButton" TargetType="{x:Type ToggleButton}">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FontSize" Value="22" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="InteractionSurface" Background="Transparent">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="17" />
                      <Border x:Name="Surface"
                              Margin="2"
                              Padding="{TemplateBinding Padding}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="Transparent"
                              BorderThickness="1"
                              CornerRadius="15">
                        <ContentPresenter VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PeachTintBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.92" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteDateDisclosureButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="6,4" />
              <Setter Property="MinHeight" Value="42" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="7">
                        <Border x:Name="Surface"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                        </Border>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainPrimaryButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
              <Setter Property="Background" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="20" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="18,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionPressedBrush}" />
                        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainSegmentButton" TargetType="{x:Type ToggleButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Height" Value="60" />
              <Setter Property="Padding" Value="18,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PinkTintSoftBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PinkTintBrush}" />
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PinkTintBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNotesSegmentButton"
                   TargetType="{x:Type ToggleButton}"
                   BasedOn="{StaticResource MainSegmentButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PeachTintBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PeachTintBrush}" />
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PeachTintBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainIconButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource IconButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="24" />
              <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="MainTopmostCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Surface" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Box"
                              Width="26"
                              Height="26"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="1"
                              CornerRadius="8"
                              VerticalAlignment="Center">
                        <Path x:Name="Tick"
                              Width="15"
                              Height="11"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,5 L 6,10 L 14,1"
                              Visibility="Collapsed" />
                      </Border>
                      <ContentPresenter Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteCompletionCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Surface" Width="30" Height="30" Background="Transparent">
                      <Border x:Name="Box"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="1"
                              CornerRadius="6">
                        <Path x:Name="Tick"
                              Width="14"
                              Height="10"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,5 L 5,9 L 13,1"
                              Visibility="Collapsed" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style TargetType="{x:Type DatePicker}"
                   BasedOn="{StaticResource {x:Type DatePicker}}">
              <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="MainCompactFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource MainFieldLabel}">
              <Setter Property="FontSize" Value="18" />
            </Style>
            <Style x:Key="MainCompactTextInput"
                   TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="MainCompactSelectionInput"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="MainCompactDateInput"
                   TargetType="{x:Type DatePicker}"
                   BasedOn="{StaticResource {x:Type DatePicker}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="MainReminderModeRadio" TargetType="{x:Type RadioButton}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid x:Name="Surface" Background="{TemplateBinding Background}">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="12" />
                      <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center">
                        <Grid Width="22" Height="22">
                          <Ellipse x:Name="Ring"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource PeachLineBrush}"
                                   StrokeThickness="2" />
                          <Ellipse x:Name="Dot"
                                   Width="10"
                                   Height="10"
                                   Fill="{DynamicResource IconAccentBrush}"
                                   Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,12,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                      </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource IconAccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainReminderHelpButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="17" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="Surface" Background="Transparent">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="15" />
                      <Ellipse x:Name="Circle"
                               Width="26"
                               Height="26"
                               Stroke="{DynamicResource MutedBrush}"
                               StrokeThickness="1.6" />
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Text="?" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>

          <!-- 锚点 Canvas：只承载装饰层与工作台骨架，业务内容全部由骨架内的
               Grid / StackPanel / UniformGrid / ScrollViewer 承载（issue #135）。 -->
          <Canvas x:Name="MainContentSurface"
                  Width="1165"
                  Height="1350"
                  Background="Transparent">
            <Canvas x:Name="CharacterBackgroundLayer"
                    Width="1165"
                    Height="1350"
                    Panel.ZIndex="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Image x:Name="MyMelodyBackground" Canvas.Left="55" Canvas.Top="1020" Width="305" Height="270" Stretch="Uniform" />
              <Image x:Name="CinnamorollBackground" Canvas.Left="390" Canvas.Top="1060" Width="380" Height="220" Stretch="Uniform" />
              <Image x:Name="KuromiBackground" Canvas.Left="815" Canvas.Top="1010" Width="270" Height="290" Stretch="Uniform" />
            </Canvas>

            <Canvas x:Name="CharacterPanelLayer"
                    Canvas.Left="38"
                    Canvas.Top="292"
                    Width="1088"
                    Height="120"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Border x:Name="CharacterPanelSurface"
                      Canvas.Top="45"
                      Width="1088"
                      Height="75"
                      BorderThickness="1"
                      CornerRadius="30,30,0,0">
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{DynamicResource CharacterPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CharacterLineBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked, ElementName=NotesTab}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NoteBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource NoteLineBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <Border x:Name="MyMelodyCharacterDock"
                      Canvas.Left="32"
                      Width="120"
                      Height="105"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="MyMelodyPanelCharacter" Height="160" Stretch="Uniform" /></Border>
              <Border x:Name="CinnamorollCharacterDock"
                      Canvas.Left="450"
                      Canvas.Top="18"
                      Width="190"
                      Height="88"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="CinnamorollPanelCharacter" Width="220" Stretch="Uniform" /></Border>
              <Border x:Name="KuromiCharacterDock"
                      Canvas.Left="936"
                      Width="120"
                      Height="105"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="KuromiPanelCharacter" Height="160" Stretch="Uniform" /></Border>
            </Canvas>

            <!-- 工作台骨架：顶部身份区 / 命令栏 / 当前工作区主卡与列表区 / 底部动作区（issue #131 #135）。 -->
            <Grid x:Name="MainWorkbenchLayout"
                  Width="1165"
                  Height="1350">
              <Grid.RowDefinitions>
                <RowDefinition Height="176" />
                <RowDefinition Height="116" />
                <RowDefinition Height="996" />
                <RowDefinition Height="62" />
              </Grid.RowDefinitions>

              <!-- 顶部身份区：标题 + 副标题 + 窗口控制 -->
              <Grid x:Name="MainIdentityZone" Grid.Row="0" Margin="40,47,22,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MainTitleZone">
                  <StackPanel Orientation="Horizontal">
                    <!-- 便签页目标图标题左侧的房子标识；倒计时页保持标题右侧心形（§12 各页对齐各自 AI 图）。 -->
                    <Path Width="44"
                          Height="40"
                          Margin="0,0,16,6"
                          VerticalAlignment="Center"
