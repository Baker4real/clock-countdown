<Window x:Class="MinminCountdown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinminCountdown"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="敏敏子倒计时"
        Width="760"
        Height="880"
        MinWidth="760"
        MinHeight="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
  <Window.Resources>
    <Style x:Key="MainKeyboardFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-3"
                    BorderBrush="{Binding Mode, Source={x:Static local:ThemeModeObserver.Instance}, Converter={StaticResource ThemeKeyboardFocusBrushConverter}}"
                    BorderThickness="3"
                    CornerRadius="8" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource BackgroundBrush}">
    <Viewbox x:Name="MainScaleViewport"
             Stretch="Uniform"
             StretchDirection="Both">
      <Canvas x:Name="MainLayoutSurface"
              Width="1165"
              Height="1350"
              ClipToBounds="True">
        <Canvas x:Name="MainReferenceDecorationLayer"
                Width="1165"
                Height="1350"
                Panel.ZIndex="1"
                IsHitTestVisible="False">
          <Image x:Name="CountdownReferenceDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
          <Image x:Name="NotesReferenceDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
          <Image x:Name="NightCountdownTopDecoration"
                 Width="1165"
                 Height="1350"
                 Stretch="Fill"
                 IsHitTestVisible="False"
                 Visibility="Collapsed" />
        </Canvas>

        <Grid x:Name="MainContentProjection"
              Width="1165"
              Height="1350"
              Panel.ZIndex="2"
              TextElement.FontSize="20"
              Background="Transparent">
          <Grid.Resources>
            <Style x:Key="MainFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource FieldLabel}">
              <Setter Property="Margin" Value="0" />
              <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="MainSecondaryButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SecondaryButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style x:Key="MainNoteStatusDisclosureButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
              <Setter Property="Background" Value="{DynamicResource NoteStatusHeaderBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource PeachLineBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="12,9" />
              <Setter Property="MinHeight" Value="66" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="10">
                        <Border x:Name="Surface"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                        </Border>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.92" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{Binding Mode, Source={x:Static local:ThemeModeObserver.Instance}, Converter={StaticResource ThemeKeyboardFocusBrushConverter}}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="InteractionSurface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteDateDisclosureButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="Padding" Value="6,4" />
              <Setter Property="MinHeight" Value="42" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="InteractionSurface">
                      <Border x:Name="FocusRing"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="2"
                              CornerRadius="7">
                        <Border x:Name="Surface"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            RecognizesAccessKey="True" />
                        </Border>
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusRing" Property="BorderBrush" Value="{Binding Mode, Source={x:Static local:ThemeModeObserver.Instance}, Converter={StaticResource ThemeKeyboardFocusBrushConverter}}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainPrimaryButton" TargetType="{x:Type Button}">
              <Setter Property="Foreground" Value="{DynamicResource MainActionTextBrush}" />
              <Setter Property="Background" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="FontSize" Value="20" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="18,0" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource MainActionPressedBrush}" />
                        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainSegmentButton"
                   TargetType="{x:Type ToggleButton}"
                   BasedOn="{StaticResource SegmentButton}">
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Height" Value="60" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style x:Key="MainIconButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource IconButton}">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Setter Property="FontSize" Value="24" />
              <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="MainTopmostCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Surface" Background="Transparent">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border x:Name="Box"
                              Width="26"
                              Height="26"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="1"
                              CornerRadius="7"
                              VerticalAlignment="Center">
                        <Path x:Name="Tick"
                              Width="15"
                              Height="11"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,5 L 6,10 L 14,1"
                              Visibility="Collapsed" />
                      </Border>
                      <ContentPresenter Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MainActionFocusBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="MainNoteCompletionCheck" TargetType="{x:Type CheckBox}">
              <Setter Property="Foreground" Value="{DynamicResource BodyBrush}" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="Surface" Width="30" Height="30" Background="Transparent">
                      <Border x:Name="Box"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="{DynamicResource CanvasBrush}"
                              BorderBrush="{DynamicResource PeachLineBrush}"
                              BorderThickness="1"
                              CornerRadius="6">
                        <Path x:Name="Tick"
                              Width="14"
                              Height="10"
                              Stroke="{DynamicResource MainActionTextBrush}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 1,5 L 5,9 L 13,1"
                              Visibility="Collapsed" />
                      </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ActiveBrush}" />
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Mode, Source={x:Static local:ThemeModeObserver.Instance}, Converter={StaticResource ThemeKeyboardFocusBrushConverter}}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="FontSize" Value="20" />
              <Setter Property="Padding" Value="18,0" />
            </Style>
            <Style TargetType="{x:Type DatePicker}"
                   BasedOn="{StaticResource {x:Type DatePicker}}">
              <Setter Property="FontSize" Value="20" />
            </Style>
            <Style x:Key="MainCompactFieldLabel"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource MainFieldLabel}">
              <Setter Property="FontSize" Value="18" />
            </Style>
            <Style x:Key="MainCompactTextInput"
                   TargetType="{x:Type TextBox}"
                   BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="MainCompactSelectionInput"
                   TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="MainCompactDateInput"
                   TargetType="{x:Type DatePicker}"
                   BasedOn="{StaticResource {x:Type DatePicker}}">
              <Setter Property="Height" Value="56" />
              <Setter Property="Padding" Value="16,0" />
            </Style>
          </Grid.Resources>

          <Canvas x:Name="MainContentSurface"
                  Width="1165"
                  Height="1350"
                  Background="Transparent">
            <Canvas x:Name="CharacterBackgroundLayer"
                    Width="1165"
                    Height="1350"
                    Panel.ZIndex="0"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Image x:Name="MyMelodyBackground" Canvas.Left="55" Canvas.Top="1020" Width="305" Height="270" Stretch="Uniform" />
              <Image x:Name="CinnamorollBackground" Canvas.Left="390" Canvas.Top="1060" Width="380" Height="220" Stretch="Uniform" />
              <Image x:Name="KuromiBackground" Canvas.Left="815" Canvas.Top="1010" Width="270" Height="290" Stretch="Uniform" />
            </Canvas>

            <TextBlock Canvas.Left="40"
                       Canvas.Top="47"
                       Text="敏敏子的时光小屋"
                       FontSize="44"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}" />
            <TextBlock Canvas.Left="40"
                       Canvas.Top="111"
                       Text="重要时刻和今日努力，都在这里慢慢长大"
                       FontSize="20"
                       Foreground="{DynamicResource MutedBrush}" />

            <Button x:Name="ThemeModeButton"
                    Canvas.Left="714"
                    Canvas.Top="59"
                    Width="142"
                    Height="48"
                    Content="◐ 自动"
                    FontSize="20"
                    Style="{StaticResource MainSecondaryButton}"
                    ToolTip="主题模式：自动；点击切换为日间"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <CheckBox x:Name="TopmostCheck"
                      Canvas.Left="872"
                      Canvas.Top="59"
                      Width="132"
                      Height="48"
                      Content="窗口置顶"
                      IsChecked="True"
                      FontSize="20"
                      Style="{StaticResource MainTopmostCheck}"
                      VerticalContentAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="MinimizeButton"
                    Canvas.Left="1019"
                    Canvas.Top="48"
                    Width="57"
                    Height="58"
                    Content="−"
                    Style="{StaticResource MainIconButton}"
                    ToolTip="最小化"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="CloseButton"
                    Canvas.Left="1086"
                    Canvas.Top="48"
                    Width="57"
                    Height="58"
                    Content="×"
                    Foreground="{DynamicResource DangerBrush}"
                    Style="{StaticResource MainIconButton}"
                    ToolTip="关闭"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />

            <Border Canvas.Left="40"
                    Canvas.Top="176"
                    Width="255"
                    Height="69"
                    Padding="4"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="14">
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="CountdownTab"
                              Width="133"
                              Content="倒计时"
                              Style="{StaticResource MainSegmentButton}" />
                <ToggleButton x:Name="NotesTab"
                              Width="111"
                              Margin="2,0,0,0"
                              Content="便签"
                              Style="{StaticResource MainSegmentButton}" />
              </StackPanel>
            </Border>
            <Button x:Name="FilterButton"
                    Canvas.Left="755"
                    Canvas.Top="176"
                    Width="133"
                    Height="69"
                    Content="筛选"
                    Style="{StaticResource MainSecondaryButton}" />
            <Button x:Name="TagManagerButton"
                    Canvas.Left="899"
                    Canvas.Top="176"
                    Width="132"
                    Height="69"
                    Content="标签"
                    Style="{StaticResource MainSecondaryButton}" />
            <TextBlock x:Name="RecordCountText"
                       Canvas.Left="1047"
                       Canvas.Top="198"
                       Width="110"
                       FontSize="20"
                       Foreground="{DynamicResource MutedBrush}"
                       TextAlignment="Center" />

            <Canvas x:Name="CharacterPanelLayer"
                    Canvas.Left="38"
                    Canvas.Top="292"
                    Width="1088"
                    Height="120"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
              <Border x:Name="CharacterPanelSurface"
                      Canvas.Top="45"
                      Width="1088"
                      Height="75"
                      BorderThickness="1"
                      CornerRadius="30,30,0,0">
                <Border.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{DynamicResource CharacterPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CharacterLineBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsChecked, ElementName=NotesTab}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NoteBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource NoteLineBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <Border x:Name="MyMelodyCharacterDock"
                      Canvas.Left="32"
                      Width="120"
                      Height="105"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="MyMelodyPanelCharacter" Height="160" Stretch="Uniform" /></Border>
              <Border x:Name="CinnamorollCharacterDock"
                      Canvas.Left="450"
                      Canvas.Top="18"
                      Width="190"
                      Height="88"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="CinnamorollPanelCharacter" Width="220" Stretch="Uniform" /></Border>
              <Border x:Name="KuromiCharacterDock"
                      Canvas.Left="936"
                      Width="120"
                      Height="105"
                      Panel.ZIndex="3"
                      BorderBrush="{DynamicResource CharacterLineBrush}"
                      BorderThickness="0"
                      CornerRadius="18"
                      ClipToBounds="True"><Image x:Name="KuromiPanelCharacter" Height="160" Stretch="Uniform" /></Border>
            </Canvas>

            <Canvas x:Name="CountdownWorkspace"
                    Width="1165"
                    Height="1350">
              <Border x:Name="CountdownWorkspaceBackdrop"
                      Canvas.Left="38"
                      Canvas.Top="402"
                      Width="1088"
                      Height="886"
                      Background="{DynamicResource BackgroundBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="0"
                      CornerRadius="16"
                      IsHitTestVisible="False" />
              <Border x:Name="CountdownEditorSurface"
                      Canvas.Left="38"
                      Canvas.Top="402"
                      Width="1088"
                      Height="384"
                      Background="{DynamicResource BackgroundBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="16" />
              <TextBlock x:Name="CountdownEditorTitle"
                         Canvas.Left="73"
                         Canvas.Top="432"
                         Text="新增倒计时"
                         FontSize="27"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource InkBrush}" />

              <TextBlock Canvas.Left="74" Canvas.Top="488" Text="名称" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBlock Canvas.Left="711" Canvas.Top="488" Text="截止日期" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBox x:Name="CountdownName"
                       Canvas.Left="73"
                       Canvas.Top="516"
                       Width="615"
                       Style="{StaticResource MainCompactTextInput}"
                       MaxLength="30" />
              <DatePicker x:Name="CountdownDate"
                          Canvas.Left="707"
                          Canvas.Top="516"
                          Width="384"
                          Style="{StaticResource MainCompactDateInput}" />

              <TextBlock Canvas.Left="74" Canvas.Top="592" Text="时" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBlock Canvas.Left="288" Canvas.Top="592" Text="分" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBlock Canvas.Left="493" Canvas.Top="592" Text="秒" Style="{StaticResource MainCompactFieldLabel}" />
              <ComboBox x:Name="CountdownHour"
                        Canvas.Left="74"
                        Canvas.Top="620"
                        Width="195"
                        Style="{StaticResource MainCompactSelectionInput}" />
              <ComboBox x:Name="CountdownMinute"
                        Canvas.Left="288"
                        Canvas.Top="620"
                        Width="188"
                        Style="{StaticResource MainCompactSelectionInput}" />
              <ComboBox x:Name="CountdownSecond"
                        Canvas.Left="493"
                        Canvas.Top="620"
                        Width="188"
                        Style="{StaticResource MainCompactSelectionInput}" />
              <Button x:Name="SetNowButton"
                      Canvas.Left="701"
                      Canvas.Top="620"
                      Width="142"
                      Height="56"
                      Content="设为现在"
                      Style="{StaticResource MainSecondaryButton}" />
              <local:TagSelector x:Name="CountdownTags"
                                 Canvas.Left="861"
                                 Canvas.Top="620"
                                 Width="222"
                                 Height="56" />
              <TextBlock x:Name="CountdownMessage"
                         Canvas.Left="74"
                         Canvas.Top="704"
                         Width="370"
                         MaxHeight="56"
                         FontSize="18"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource DangerBrush}"
                         TextWrapping="Wrap" />
              <Button x:Name="ManageCountdownReminderRulesButton"
                      Canvas.Left="460"
                      Canvas.Top="704"
                      Width="170"
                      Height="56"
                      Content="提醒规则"
                      Style="{StaticResource MainSecondaryButton}" />
              <TextBlock x:Name="CountdownReminderRulesSummary"
                         Canvas.Left="642"
                         Canvas.Top="704"
                         Width="132"
                         Height="56"
                         FontSize="16"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"
                         TextWrapping="Wrap" />
              <Button x:Name="CancelCountdownEdit"
                      Canvas.Left="786"
                      Canvas.Top="704"
                      Width="72"
                      Height="56"
                      Content="取消"
                      Visibility="Collapsed"
                      Style="{StaticResource MainSecondaryButton}" />
              <Button x:Name="SaveCountdownButton"
                      Canvas.Left="866"
                      Canvas.Top="704"
                      Width="221"
                      Height="56"
                      MinHeight="56"
                      Content="添加倒计时"
                      Style="{StaticResource MainPrimaryButton}" />

              <Border x:Name="CountdownPreferencesSurface"
                      Canvas.Left="38"
                      Canvas.Top="810"
                      Width="1088"
                      Height="140"
                      Background="{DynamicResource BackgroundBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="16" />
              <TextBlock Canvas.Left="74" Canvas.Top="832" Text="显示精度" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBlock Canvas.Left="309" Canvas.Top="832" Text="月薪（元）" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBlock Canvas.Left="571" Canvas.Top="832" Text="上班时间" Style="{StaticResource MainCompactFieldLabel}" />
              <TextBlock Canvas.Left="778" Canvas.Top="832" Text="下班时间" Style="{StaticResource MainCompactFieldLabel}" />
              <ComboBox x:Name="DisplayPrecision"
                        Canvas.Left="73"
                        Canvas.Top="860"
                        Width="210"
                        Style="{StaticResource MainCompactSelectionInput}" />
              <TextBox x:Name="MonthlySalary"
                       Canvas.Left="306"
                       Canvas.Top="860"
                       Width="243"
                       Style="{StaticResource MainCompactTextInput}" />
              <TextBox x:Name="WorkStart"
                       Canvas.Left="568"
                       Canvas.Top="860"
                       Width="187"
                       Style="{StaticResource MainCompactTextInput}" />
              <TextBox x:Name="WorkEnd"
                       Canvas.Left="773"
                       Canvas.Top="860"
                       Width="172"
                       Style="{StaticResource MainCompactTextInput}" />
              <Button x:Name="SavePreferencesButton"
                      Canvas.Left="961"
                      Canvas.Top="860"
                      Width="140"
                      Height="56"
                      MinHeight="56"
                      Content="保存设置"
                      Style="{StaticResource MainPrimaryButton}" />

              <ScrollViewer x:Name="CountdownListRegion"
                            Canvas.Left="40"
                            Canvas.Top="972"
                            Width="1085"
                            Height="316"
                            FocusVisualStyle="{StaticResource MainKeyboardFocusVisual}"
                            Focusable="True"
                            IsTabStop="True"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <StackPanel x:Name="CountdownRows" />
                  <TextBlock x:Name="EmptyCountdownMessage"
                             Margin="20,20,20,0"
                             HorizontalAlignment="Center"
                             FontSize="20"
                             Foreground="{DynamicResource MutedBrush}"
                             Text="还没有倒计时，先添加一个目标。"
                             TextWrapping="Wrap"
                             Visibility="Collapsed" />
                  <Button x:Name="ResetEmptyCountdownFiltersButton"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Center"
                          Content="重置筛选"
                          Visibility="Collapsed"
                          Style="{StaticResource MainSecondaryButton}" />
                </StackPanel>
              </ScrollViewer>
            </Canvas>

            <Canvas x:Name="NotesWorkspace"
                    Width="1165"
                    Height="1350"
                    Visibility="Collapsed">
              <Border x:Name="NoteEditorPanel"
                      Canvas.Left="46"
                      Canvas.Top="368"
                      Width="1072"
                      Height="400"
                      Panel.ZIndex="-2"
                      Background="{DynamicResource WorkspacePanelBrush}"
                      BorderBrush="{DynamicResource WorkspacePanelLineBrush}"
                      BorderThickness="1"
                      CornerRadius="40" />
              <Image x:Name="NightNotesTopDecoration"
                     Width="1165"
                     Height="1350"
                     Panel.ZIndex="-1"
                     Stretch="Fill"
                     IsHitTestVisible="False"
                     Visibility="Collapsed" />
              <TextBlock x:Name="NoteTextLabel"
                         Canvas.Left="72"
                         Canvas.Top="412"
                         Text="便签内容"
                         Style="{StaticResource MainFieldLabel}" />
              <TextBlock x:Name="NoteDateLabel"
                         Canvas.Left="675"
                         Canvas.Top="412"
                         Text="便签日期"
                         Style="{StaticResource MainFieldLabel}" />
              <TextBox x:Name="NoteText"
                       Canvas.Left="72"
                       Canvas.Top="449"
                       Width="588"
                       Height="68"
                       MaxLength="140" />
              <DatePicker x:Name="NoteDate"
                          Canvas.Left="675"
                          Canvas.Top="449"
                          Width="244"
                          Height="68"
                          SelectedDateFormat="Short" />
              <Button x:Name="SaveNoteButton"
                      Canvas.Left="926"
                      Canvas.Top="449"
                      Width="118"
                      Height="68"
                      Content="添加"
                      Style="{StaticResource MainPrimaryButton}" />
              <Button x:Name="CancelNoteEdit"
                      Canvas.Left="1052"
                      Canvas.Top="449"
                      Width="66"
                      Height="68"
                      Content="取消"
                      Visibility="Collapsed"
                      Style="{StaticResource MainSecondaryButton}" />
              <TextBlock x:Name="NoteReminderModeLabel"
                         Canvas.Left="72"
                         Canvas.Top="526"
                         Text="提醒规则"
                         Style="{StaticResource MainFieldLabel}" />
              <TextBlock x:Name="NoteTagsLabel"
                         Canvas.Left="289"
                         Canvas.Top="526"
                         Text="标签"
                         Style="{StaticResource MainFieldLabel}" />
              <TextBlock x:Name="NoteSearchLabel"
                         Canvas.Left="867"
                         Canvas.Top="526"
                         Text="搜索便签"
                         Style="{StaticResource MainFieldLabel}" />
              <Button x:Name="ManageNoteReminderRulesButton"
                      Canvas.Left="72"
                      Canvas.Top="556"
                      Width="202"
                      Height="69"
                      Content="管理提醒规则"
                      Style="{StaticResource MainSecondaryButton}" />
              <TextBlock x:Name="NoteReminderRulesSummary"
                         Canvas.Left="72"
                         Canvas.Top="632"
                         Width="790"
                         Height="38"
                         FontSize="17"
                         Foreground="{DynamicResource MutedBrush}"
                         TextWrapping="Wrap"
                         Text="不提醒" />
              <local:TagSelector x:Name="NoteTags"
                                 Canvas.Left="289"
                                 Canvas.Top="556"
                                 Width="172"
                                 Height="69" />
              <TextBox x:Name="NoteSearch"
                       Canvas.Left="867"
                       Canvas.Top="556"
                       Width="220"
                       Height="69"
                       MaxLength="140" />
              <TextBlock x:Name="NoteMessage"
                         Canvas.Left="72"
                         Canvas.Top="720"
                         Width="790"
                         Height="42"
                         FontSize="18"
                         Foreground="{DynamicResource DangerBrush}"
                         TextWrapping="Wrap" />
              <ScrollViewer x:Name="NotesListRegion"
                            Canvas.Left="46"
                            Canvas.Top="784"
                            Width="1072"
                            Height="486"
                            FocusVisualStyle="{StaticResource MainKeyboardFocusVisual}"
                            Focusable="True"
                            IsTabStop="True"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <Button x:Name="ToggleActiveNotes"
                          Visibility="Collapsed"
                          Style="{StaticResource MainNoteStatusDisclosureButton}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="5"
                              Height="34"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Background="{DynamicResource NoteActiveRailBrush}"
                              CornerRadius="3" />
                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ActiveNotesLabel"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="未完成" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="16"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="正在照顾的事情" />
                      </StackPanel>
                      <TextBlock x:Name="ActiveNotesCount"
                                 Grid.Column="2"
                                 MinWidth="40"
                                 VerticalAlignment="Center"
                                 FontSize="22"
                                 Foreground="{DynamicResource MutedBrush}"
                                 Text="0"
                                 TextAlignment="Right"
                                 Typography.NumeralAlignment="Tabular" />
                      <Path x:Name="ActiveNotesChevron"
                            Grid.Column="3"
                            Width="14"
                            Height="9"
                            Margin="16,0,3,0"
                            VerticalAlignment="Center"
                            Data="M 1,1 L 7,7 L 13,1"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform"
                            Stroke="{DynamicResource BodyBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2">
                        <Path.RenderTransform>
                          <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                      </Path>
                    </Grid>
                  </Button>
                  <StackPanel x:Name="ActiveNoteRows" Margin="26,6,0,0" />
                  <Button x:Name="ToggleCompletedNotes"
                          Margin="0,10,0,0"
                          Background="{DynamicResource NoteCompletedHeaderBrush}"
                          Visibility="Collapsed"
                          Style="{StaticResource MainNoteStatusDisclosureButton}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="5"
                              Height="34"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Background="{DynamicResource NoteCompletedRailBrush}"
                              CornerRadius="3" />
                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CompletedNotesLabel"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="已完成" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="16"
                                   Foreground="{DynamicResource NoteCompletedAuxiliaryBrush}"
                                   Text="收好，但随时能找回" />
                      </StackPanel>
                      <TextBlock x:Name="CompletedNotesCount"
                                 Grid.Column="2"
                                 MinWidth="40"
                                 VerticalAlignment="Center"
                                 FontSize="22"
                                 Foreground="{DynamicResource MutedBrush}"
                                 Text="0"
                                 TextAlignment="Right"
                                 Typography.NumeralAlignment="Tabular" />
                      <Path x:Name="CompletedNotesChevron"
                            Grid.Column="3"
                            Width="14"
                            Height="9"
                            Margin="16,0,3,0"
                            VerticalAlignment="Center"
                            Data="M 1,1 L 7,7 L 13,1"
                            RenderTransformOrigin="0.5,0.5"
                            Stretch="Uniform"
                            Stroke="{DynamicResource NoteCompletedAuxiliaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="2">
                        <Path.RenderTransform>
                          <RotateTransform Angle="-90" />
                        </Path.RenderTransform>
                      </Path>
                    </Grid>
                  </Button>
                  <StackPanel x:Name="CompletedNoteRows" Margin="26,6,0,0" Visibility="Collapsed" />
                  <TextBlock x:Name="EmptyNotesMessage"
                             Margin="0,40,0,0"
                             HorizontalAlignment="Center"
                             FontSize="20"
                             Foreground="{DynamicResource MutedBrush}"
                             Text="还没有便签，先写下一件想记住的事。"
                             Visibility="Collapsed" />
                  <Button x:Name="ResetEmptyNotesFiltersButton"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Center"
                          Content="重置筛选"
                          Visibility="Collapsed"
                          Style="{StaticResource MainSecondaryButton}" />
                </StackPanel>
              </ScrollViewer>
            </Canvas>

            <TextBlock x:Name="NowText"
                       Canvas.Left="40"
                       Canvas.Top="1298"
                       Width="760"
                       FontSize="18"
                       Foreground="{DynamicResource MutedBrush}" />
            <TextBlock x:Name="StatusText"
                       Canvas.Left="800"
                       Canvas.Top="1298"
                       Width="320"
                       FontSize="18"
                       Foreground="{DynamicResource MutedBrush}"
                       FocusVisualStyle="{StaticResource MainKeyboardFocusVisual}"
                       Focusable="True"
                       KeyboardNavigation.IsTabStop="True"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" />

            <Popup x:Name="FilterPopup"
                   PlacementTarget="{Binding ElementName=FilterButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="None">
              <Border MinWidth="480"
                      MaxHeight="520"
                      Margin="0,8,0,0"
                      Padding="20"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="12">
                <ScrollViewer MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Text="标签匹配" FontSize="18" FontWeight="SemiBold" />
                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <ToggleButton x:Name="AnyTagMode" Content="任一匹配" Style="{DynamicResource FilterOptionButton}" />
                    <ToggleButton x:Name="AllTagMode" Margin="6,0,0,0" Content="全部匹配" Style="{DynamicResource FilterOptionButton}" />
                    <ToggleButton x:Name="UntaggedOnly" Margin="6,0,0,0" Content="无标签" Style="{DynamicResource FilterOptionButton}" />
                  </StackPanel>
                  <WrapPanel x:Name="FilterTagOptions" Margin="0,8,0,0" />
                  <StackPanel x:Name="CountdownFilterOptions" Margin="0,12,0,0">
                    <TextBlock Text="倒计时状态" FontWeight="SemiBold" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <ToggleButton x:Name="CountdownAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="CountdownActiveFilter" Margin="6,0,0,0" Content="未到期" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="CountdownExpiredFilter" Margin="6,0,0,0" Content="已到期" Style="{DynamicResource FilterOptionButton}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="NoteFilterOptions" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="便签状态与日期" FontWeight="SemiBold" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <ToggleButton x:Name="NoteAllFilter" Content="全部" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteActiveFilter" Margin="6,0,0,0" Content="未完成" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteCompletedFilter" Margin="6,0,0,0" Content="已完成" Style="{DynamicResource FilterOptionButton}" />
                      <ToggleButton x:Name="NoteUndatedFilter" Margin="6,0,0,0" Content="未设日期" Style="{DynamicResource FilterOptionButton}" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <DatePicker x:Name="NoteDateFilter" Width="230" />
                      <Button x:Name="ClearNoteDateFilter"
                              Width="76"
                              Margin="6,0,0,0"
                              Content="清除"
                              Style="{DynamicResource SecondaryButton}" />
                    </StackPanel>
                  </StackPanel>
                  <Button x:Name="ClearFilterButton"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Right"
                          Content="重置筛选"
                          Style="{DynamicResource SecondaryButton}" />
                </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>

            <Popup x:Name="TagManagerPopup"
                   PlacementTarget="{Binding ElementName=TagManagerButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="None">
              <Border MinWidth="430"
                      MaxHeight="520"
                      Margin="0,8,0,0"
                      Padding="20"
                      Background="{DynamicResource CanvasBrush}"
                      BorderBrush="{DynamicResource PeachLineBrush}"
                      BorderThickness="1"
                      CornerRadius="12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="NewTagInputLabel"
                               Text="新标签名称"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}" />
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="NewTagInput" MaxLength="30" />
                      <Button x:Name="CreateTagButton"
                              Grid.Column="1"
                              Width="80"
                              Margin="8,0,0,0"
                              Content="新建"
                              Style="{DynamicResource PrimaryButton}" />
                    </Grid>
                  </StackPanel>
                  <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TagManagerRows" />
                  </ScrollViewer>
                  <TextBlock x:Name="TagManagerMessage"
                             Grid.Row="2"
                             Margin="2,8,2,0"
                             Foreground="{DynamicResource DangerBrush}"
                             TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Popup>
          </Canvas>
        </Grid>
      </Canvas>
    </Viewbox>
  </Grid>
</Window>
